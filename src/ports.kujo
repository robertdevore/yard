# Yard :: ports
#
# The scanner. It shells out to `lsof` to list listening TCP sockets and parses
# the output into structured DetectedProcess dicts. Everything here is defensive:
# if `lsof` is missing, permission-limited, or prints something unexpected, we
# degrade to "as much as we could learn" rather than crashing the dashboard.
#
# Only read-only inspection commands are ever run here (lsof, ps). Nothing in
# this module signals, starts, or stops a process.

from src.util import truthy, split_ws, last_segment, drop_last_segment

# Run the listener scan. Returns:
#   { "ok": bool, "error": str|null, "processes": [DetectedProcess, ...] }
# A DetectedProcess is:
#   { pid, port, address, protocol, ip_version, process_name, command, user, raw }
export func scan() {
    result := scan_listeners()
    result["listeners"] := result["processes"]
    result["processes"] := unique_ports(result["listeners"])
    return result
}

# Keep separate listeners for control decisions. The status and raw ports
# views retain their established one-row-per-port shape.
export func scan_listeners() {
    r := execute_status("lsof -nP -iTCP -sTCP:LISTEN +c 0", {"timeout_ms": 1700, "max_output_bytes": 524288})
    output := trim(r.stdout)
    stderr := trim(r.stderr)
    parsed := parse_listener_rows(output)
    processes := parsed["processes"]
    if r.timed_out || r.stdout_truncated || parsed["skipped"] > 0 {
        return {"ok": false, "error": "listener scan incomplete; lsof returned truncated or unrecognized rows", "processes": processes}
    }
    if r.exitcode == 0 || (r.exitcode == 1 && output == "" && stderr == "") {
        return {"ok": true, "error": null, "processes": processes}
    }
    detail := "listener scan failed (lsof exit ${r.exitcode}); check installation and permissions"
    return {"ok": false, "error": detail, "processes": processes}
}

export func parse_lsof(text) {
    return unique_ports(parse_lsof_listeners(text))
}

func unique_ports(listeners) {
    mut processes := []
    mut seen := {}
    for listener in listeners {
        key := "${listener["port"]}"
        if truthy(has_key(seen, key)) == false {
            seen[key] := true
            processes = push(processes, listener)
        }
    }
    return processes
}

export func parse_lsof_listeners(text) {
    return parse_listener_rows(text)["processes"]
}

func parse_listener_rows(text) {
    mut processes := []
    mut seen := {}
    mut skipped := 0
    for raw in split(text, "\n") {
        line := trim(raw)
        tokens := split_ws(line)
        if len(tokens) == 0 || (len(tokens) >= 2 && tokens[0] == "COMMAND" && tokens[1] == "PID") {
            continue
        }
        listener := null
        if len(tokens) >= 9 {
            listener = parse_lsof_row(tokens, line)
        }
        if type(listener) == "null" {
            skipped = skipped + 1
            continue
        }
        key := "${listener["pid"]}:${listener["port"]}:${listener["address"]}"
        if truthy(has_key(seen, key)) == false {
            seen[key] := true
            processes = push(processes, listener)
        }
    }
    return {"processes": processes, "skipped": skipped}
}

# Turn one tokenized lsof row into a DetectedProcess, or null if it does not
# look like a usable LISTEN row. The NAME column (address:port) is the token
# just before the trailing "(LISTEN)" marker.
func parse_lsof_row(tokens, raw) {
    n := len(tokens)
    name_idx := n - 2
    if substring(tokens[n - 1], 0, 1) != "(" {
        # No "(LISTEN)" suffix; treat the last token as NAME.
        name_idx = n - 1
    }
    name := tokens[name_idx]
    port_str := last_segment(name, ":")
    if port_str == "" || port_str == name {
        return null
    }
    port := parse_int(port_str)
    if type(port) != "int" {
        return null
    }
    if port <= 0 || port > 65535 {
        return null
    }
    address := drop_last_segment(name, ":")
    if address == "" {
        address = "*"
    }
    ip_version := "IPv4"
    if len(tokens) >= 5 {
        ip_version = tokens[4]
    }
    process_name := tokens[0]
    pid := parse_int(tokens[1])
    if valid_pid(pid) == false {
        return null
    }
    user := tokens[2]
    return {
        "pid": pid,
        "port": port,
        "address": address,
        "protocol": "TCP",
        "ip_version": ip_version,
        "process_name": process_name,
        "command": null,
        "user": user,
        "raw": raw
    }
}

# Best-effort full command line for a PID via `ps`. Returns null if the PID is
# gone or ps is unavailable. Used to enrich display ("node server.js") and to
# refine sensitive-service detection.
export func full_command(pid) {
    if valid_pid(pid) == false {
        return null
    }
    r := execute_status("ps -o command= -p ${pid}")
    if r.exitcode != 0 {
        return null
    }
    cmd := trim("${r.stdout}")
    if cmd == "" {
        return null
    }
    return cmd
}

export func valid_pid(pid) {
    return type(pid) == "int" && pid > 0 && pid <= 2147483647
}

# Read the process start time and state in one call. A reused PID must never
# inherit a tracked service's authorization to be signaled.
export func process_identity(pid) {
    if valid_pid(pid) == false {
        return {"started": null, "error": "invalid pid"}
    }
    r := execute_status("LC_ALL=C ps -p ${pid} -o stat= -o lstart=")
    fields := split_ws(trim(r.stdout))
    if r.exitcode == 1 && len(fields) == 0 && trim(r.stderr) == "" {
        return {"started": null, "error": null}
    }
    if r.exitcode != 0 || len(fields) != 6 {
        return {"started": null, "error": "could not inspect pid ${pid}: ${trim(r.stderr)}"}
    }
    if substring(fields[0], 0, 1) == "Z" {
        return {"started": null, "error": null}
    }
    return {"started": join([fields[1], fields[2], fields[3], fields[4], fields[5]], " "), "error": null}
}
