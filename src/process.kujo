# Yard process control. The state lock is shared by CLI and HTTP service
# actions and released by the OS if a Yard process exits.
from src.util import truthy, shell_quote
from src.ports import scan_listeners, process_identity, full_command
from src.state import state_dir, load_control_state, save_state, get_entry, new_entry, log_path, ensure_dirs
from src.config import service_for_port
from src.knownports import is_sensitive, sensitive_listener

export func control_service(svc, all_services, action, force, confirm) {
    mut lock := null
    try {
        ensure_dirs()
        lock = file_lock(join_path(state_dir(), "managed.lock"), 5000)
    } except e {
        return failure("could not lock managed state: ${e}")
    }
    mut result := null
    try {
        result = control_locked(svc, all_services, action, force, confirm)
    } except e {
        result = failure("could not ${action} service '${svc["id"]}': ${e}")
    }
    file_unlock(lock)
    return result
}

func control_locked(svc, all_services, action, force, confirm) {
    id := svc["id"]
    cwd := svc["cwd"]
    log_file := log_path(id)
    if action != "stop" {
        if type(svc["start"]) != "string" || trim(svc["start"]) == "" {
            return failure("service '${id}' has no 'start' command configured")
        }
        if cwd == null || cwd == "" {
            cwd = "."
        }
        if path_is_dir(cwd) == false {
            return failure("service '${id}' cwd does not exist: ${cwd}")
        }
        if path_is_dir(log_file) {
            return failure("service '${id}' log path is a directory: ${log_file}")
        }
    }
    state := load_control_state()
    entry := get_entry(state, id)
    scan := scan_listeners()
    if scan["ok"] == false {
        return failure(scan["error"])
    }

    listeners := scan["processes"]
    targets := listener_pids(listeners, svc["port"], null)
    if len(targets) > 1 {
        return failure("multiple processes listen on port ${svc["port"]}; inspect them before controlling this service")
    }
    pid := null
    if len(targets) == 1 {
        pid = targets[0]
        if action == "start" {
            return failure("port ${svc["port"]} is already listening (pid ${pid})")
        }
    } else {
        if type(entry) == "dict" {
            pid = get(entry, "pid")
        }
    }

    mut started := null
    if type(pid) == "int" {
        identity := process_identity(pid)
        if identity["error"] != null {
            return failure(identity["error"])
        }
        started = identity["started"]
        if len(targets) == 0 && started != null {
            expected := get(entry, "process_started")
            if expected == null {
                return failure("cannot verify legacy tracked pid ${pid}; wait for a listener or stop it outside Yard")
            }
            if expected != started {
                started = null
            }
        }
    }

    if action == "start" {
        if started != null {
            return failure("service '${id}' is already running (pid ${pid})")
        }
        return launch(svc, cwd, log_file, state, entry, false)
    }

    sensitive := truthy(svc["sensitive"]) || is_sensitive(svc["port"], svc["start"])
    if started != null {
        sensitive = sensitive || listener_sensitive(listeners, all_services, pid)
    }
    guard := confirmation(sensitive, force, confirm)
    if guard != null {
        return guard
    }
    if action == "stop" {
        if type(pid) != "int" {
            return failure("no running process found for '${id}'")
        }
        return signal_process(pid, started, force)
    }
    if started != null {
        stopped := signal_process(pid, started, false)
        if stopped["ok"] == false {
            return stopped
        }
        remaining := wait_for_exit(pid, started)
        if remaining != null {
            return failure(remaining)
        }
    }
    if type(pid) == "int" {
        # Recheck the configured port after waiting for the old process.
        scan = scan_listeners()
        if scan["ok"] == false {
            return failure(scan["error"])
        }
        if len(listener_pids(scan["processes"], svc["port"], null)) > 0 {
            return failure("port ${svc["port"]} is still in use; inspect listeners before retrying")
        }
    }
    return launch(svc, cwd, log_file, state, entry, true)
}

func launch(svc, cwd, log_file, state, entry, restarting) {
    id := svc["id"]
    log_abs := absolute_path(log_file)
    # Open the log and enter cwd before reporting a PID. Redirect stdin too,
    # so the service never inherits a caller's terminal or HTTP request pipe.
    script := "cd " + shell_quote(absolute_path(cwd)) + " || exit 1; "
    script = script + "exec 3>" + shell_quote(log_abs) + " || exit 1; "
    script = script + "exec nohup " + svc["start"] + " < /dev/null >&3 2>&1 3>&- & echo $!"
    started := execute_status(script)
    pid := parse_int(trim(started.stdout))
    if started.exitcode != 0 || type(pid) != "int" || pid <= 0 {
        return failure("could not launch '${id}': ${trim(started.stderr)}")
    }
    identity := process_identity(pid)
    if identity["error"] != null || identity["started"] == null {
        return failure("could not verify launch of '${id}' (pid ${pid}); check ${log_file}")
    }

    count := 0
    if type(entry) == "dict" && type(get(entry, "restart_count")) == "int" {
        count = entry["restart_count"]
    }
    if restarting {
        count = count + 1
    }
    state[id] := new_entry(pid, identity["started"], log_file, svc["start"], count)
    mut save_error := null
    try {
        if save_state(state) != true {
            save_error = "atomic write failed"
        }
    } except e {
        save_error = "${e}"
    }
    if save_error != null {
        rollback := signal_process(pid, identity["started"], false)
        if rollback["ok"] {
            return failure("could not save state for '${id}' (sent TERM to pid ${pid}): ${save_error}")
        }
        return failure("could not save state for '${id}' or stop pid ${pid}: ${save_error}; ${rollback["error"]}")
    }
    return {"ok": true, "error": null, "pid": pid, "log_file": log_file}
}

# Select exact PIDs for the requested port or PID. A failed scan must never
# authorize a signal, and all selected listeners are checked before signaling.
export func control_listeners(services, port, requested_pid, force, confirm) {
    scan := scan_listeners()
    if scan["ok"] == false {
        return failure(scan["error"])
    }
    listeners := scan["processes"]
    targets := listener_pids(listeners, port, requested_pid)
    if len(targets) == 0 {
        if type(requested_pid) == "int" {
            return failure("pid ${requested_pid} is not a detected TCP listener")
        }
        return {"ok": true, "error": null, "stopped": [], "signal": "none"}
    }

    mut identities := {}
    mut sensitive := false
    for pid in targets {
        identity := process_identity(pid)
        if identity["error"] != null {
            return failure(identity["error"])
        }
        identities["${pid}"] := identity["started"]
        if listener_sensitive(listeners, services, pid) {
            sensitive = true
        }
    }
    guard := confirmation(sensitive, force, confirm)
    if guard != null {
        return guard
    }

    mut stopped := []
    mut result := {"ok": true, "error": null, "signal": "none"}
    for pid in targets {
        result = signal_process(pid, identities["${pid}"], force)
        if result["ok"] == false {
            break
        }
        stopped = push(stopped, pid)
    }
    result["stopped"] := stopped
    return result
}

func listener_pids(listeners, port, requested_pid) {
    mut seen := {}
    mut targets := []
    for listener in listeners {
        pid := listener["pid"]
        key := "${pid}"
        if (port == listener["port"] || requested_pid == pid) && has_key(seen, key) == 0 {
            seen[key] := true
            targets = push(targets, pid)
        }
    }
    return targets
}

func listener_sensitive(listeners, services, pid) {
    cmd := full_command(pid)
    if is_sensitive(null, cmd) {
        return true
    }
    for listener in listeners {
        if listener["pid"] == pid {
            service := service_for_port(services, listener["port"])
            if sensitive_listener(listener, service, cmd) {
                return true
            }
        }
    }
    return false
}

func confirmation(sensitive, force, confirm) {
    if truthy(confirm) {
        return null
    }
    if truthy(force) {
        return {"ok": false, "needs_confirm": true, "error": "force stop requires explicit confirmation"}
    }
    if sensitive {
        return {"ok": false, "needs_confirm": true, "error": "controlling a sensitive service requires explicit confirmation"}
    }
    return null
}

func signal_process(pid, expected, force) {
    if expected == null {
        return gone(pid)
    }
    current := process_identity(pid)
    if current["error"] != null {
        return failure(current["error"])
    }
    if current["started"] != expected {
        return gone(pid)
    }
    signal := "TERM"
    if truthy(force) {
        signal = "KILL"
    }
    r := execute_status("kill -${signal} ${pid}")
    if r.exitcode != 0 {
        return {"ok": false, "error": trim(r.stderr), "signal": signal}
    }
    return {"ok": true, "error": null, "signal": signal}
}

func wait_for_exit(pid, expected) {
    mut attempt := 0
    while attempt <= 20 {
        identity := process_identity(pid)
        if identity["error"] != null {
            return identity["error"]
        }
        if identity["started"] != expected {
            return null
        }
        if attempt < 20 {
            sleep(100)
        }
        attempt = attempt + 1
    }
    return "pid ${pid} is still running after SIGTERM; restart did not launch a replacement"
}

func gone(pid) {
    return {"ok": true, "error": null, "signal": "none", "note": "process ${pid} was already gone"}
}

func failure(message) {
    return {"ok": false, "error": message}
}

func absolute_path(path) {
    if starts_with(path, "/") {
        return path
    }
    return join_path(os_getcwd(), path)
}
