# Lifecycle actions and registry writes share a lock across CLI and dashboard.
from src.util import truthy, iso_now
from src.ports import scan_listeners, full_command
from src.state import state_dir, load_control_state, save_state, get_entry, ensure_dirs
from src.config import load, resolve_path, service_by_id, service_for_port
from src.knownports import is_sensitive, sensitive_listener
from src.supervisor import supervisor, absolute_path, groups
from src.health import service_health

export func control_service(svc, action, force, confirm, target) {
    mut lock := null
    try {
        ensure_dirs()
        lock = file_lock(join_path(state_dir(), "managed.lock"), 15000)
    } except e {
        return failure("could not lock managed state: ${e}")
    }
    mut result := null
    try {
        config := load(resolve_path(null))
        current := service_by_id(config["services"], svc["id"])
        if len(config["errors"]) > 0 || type(current) != "dict" {
            result = failure("registry is invalid or the service was removed; review the configuration")
        } else {
            result = control_locked(current, config["services"], action, force, confirm, target)
        }
    } except e {
        result = failure("could not ${action} '${svc["id"]}': ${e}")
    }
    file_unlock(lock)
    return result
}

func control_locked(svc, services, action, force, confirm, target) {
    id := svc["id"]
    port := svc["port"]
    state := load_control_state()
    entry := get_entry(state, id)
    spec := get(entry, "supervisor")
    owned := null
    if type(spec) == "dict" {
        r := supervisor("status", spec, 1300)
        if r["ok"] == false {
            return r
        }
        owned = r["receipt"]
        old_group := get(entry, "pid")
        if owned == null && type(old_group) == "int" && get(entry, "outcome") != "stopped" {
            table := groups()
            for key in keys(table) {
                if table[key] == old_group {
                    return failure("The prior process group may still exist, but its supervisor is unavailable. Inspect it from its original launcher.")
                }
            }
        }
    }
    if target != null && get(owned, "pid") != target {
        return failure("The confirmed process group changed; inspect the service before trying again.")
    }
    if action != "stop" {
        if svc["enabled"] == false {
            return failure("Management is disabled for '${id}'")
        }
        if type(svc["start"]) != "string" || trim(svc["start"]) == "" {
            return failure("Service '${id}' has no startup command")
        }
        if path_is_dir(svc["cwd"]) == false {
            return failure("Working directory does not exist: ${svc["cwd"]}")
        }
    }
    scan := scan_listeners()
    if scan["ok"] == false {
        return failure(scan["error"])
    }
    listeners := scan["processes"]
    occupied := port_listener(listeners, port)
    if action == "start" && owned != null {
        return failure("Service '${id}' is already running (process group ${owned["pid"]})")
    }
    if owned == null && occupied != null {
        return failure("Port ${port} is occupied by an external listener (PID ${occupied["pid"]}). Stop it from its own launcher.")
    }
    if owned == null && action == "stop" {
        if type(get(entry, "pid")) == "int" && type(spec) != "dict" {
            return failure("Cannot verify legacy tracked PID. Use the application's original launcher.")
        }
        return {"ok": true, "error": null, "signal": "none", "note": "Service is already stopped"}
    }
    if owned != null {
        sensitive := truthy(svc["sensitive"]) || is_sensitive(port, svc["start"])
        table := groups()
        if get(table, "${owned["pid"]}") != owned["pid"] {
            return failure("Could not verify the running process group")
        }
        for key in keys(table) {
            if table[key] == owned["pid"] && is_sensitive(null, full_command(parse_int(key))) {
                sensitive = true
                break
            }
        }
        for listener in listeners {
            if sensitive == false && get(table, "${listener["pid"]}") == owned["pid"] {
                current := service_for_port(services, listener["port"])
                if sensitive_listener(listener, current, full_command(listener["pid"])) {
                    sensitive = true
                }
            }
        }
        if sensitive && force {
            return failure("Force Stop is disabled for sensitive process group ${owned["pid"]}")
        }
        if (force || sensitive) && confirm == false {
            return {"ok": false, "needs_confirm": true, "error": "Confirm ${action} of process group ${owned["pid"]}"}
        }
        operation := "stop"
        signal := "TERM"
        if force {
            operation = "force"
            signal = "KILL"
        }
        spec["shutdown_timeout"] := svc["shutdown_timeout"]
        stopped := supervisor(operation, spec, (svc["shutdown_timeout"] + 2) * 1000)
        if stopped["ok"] == false {
            entry["outcome"] := "stop_failed"
            entry["error"] := get(stopped, "error")
            state[id] := entry
            save_state(state)
            return stopped
        }
        entry["outcome"] := "stopped"
        entry["error"] := null
        state[id] := entry
        save_state(state)
        remaining := scan_listeners()
        if remaining["ok"] == false {
            return failure("Process group exited, but Yard could not verify port release")
        }
        if port_listener(remaining["processes"], port) != null {
            return failure("Process group exited, but port ${port} is still occupied")
        }
        if action == "stop" {
            return {"ok": true, "error": null, "signal": signal}
        }
    }
    return launch(svc, state, entry, action == "restart")
}

func launch(svc, state, previous, restarting) {
    id := svc["id"]
    count := get(previous, "restart_count")
    if type(count) != "int" {
        count = 0
    }
    log := absolute_path(join_path(state_dir(), "private-logs/${id}.log"))
    spec := {
        "socket": reveal(secure_random_token(24)) + ".sock",
        "token": reveal(secure_random_token(32)),
        "control_dir": absolute_path(join_path(state_dir(), "control")),
        "log": log,
        "cwd": absolute_path(svc["cwd"]),
        "start": svc["start"],
        "port": svc["port"],
        "executable": svc["executable"],
        "env": svc["env"],
        "shutdown_timeout": svc["shutdown_timeout"]
    }
    entry := {"supervisor": spec, "started_at": iso_now(), "restart_count": count, "outcome": "starting", "error": null}
    state[id] := entry
    save_state(state)
    started := supervisor("launch", spec, 2500)
    if started["ok"] == false {
        return record_failure(state, id, entry, started["error"])
    }
    pid := started["receipt"]["pid"]
    entry["pid"] := pid
    entry["child"] := started["receipt"]["child"]
    state[id] := entry
    save_state(state)
    deadline := current_timestamp() + svc["startup_timeout"] * 1000
    mut tries := 0
    mut health := "unknown"
    while current_timestamp() < deadline {
        live := supervisor("status", spec, 1300)
        if live["ok"] == false || live["receipt"] == null {
            return record_failure(state, id, entry, "Startup command exited or ownership could not be verified. Check recent logs.")
        }
        ready := svc["port"] == null
        if ready == false {
            scan := scan_listeners()
            table := groups()
            for listener in scan["processes"] {
                if listener["port"] == svc["port"] && get(table, "${listener["pid"]}") == pid {
                    ready = true
                }
            }
        }
        if ready {
            health = service_health(svc, svc["probe_timeout_ms"] / 1000.0)["status"]
            if health == "healthy" || health == "process" || health == "not_checked" {
                if tries > 0 || svc["port"] != null {
                    entry["outcome"] := "running"
                    entry["health"] := health
                    if restarting {
                        entry["restart_count"] := count + 1
                    }
                    state[id] := entry
                    save_state(state)
                    return {"ok": true, "error": null, "pid": pid, "log_file": log, "note": "Readiness confirmed (${health})"}
                }
            }
        }
        tries = tries + 1
        sleep(150)
    }
    return record_failure(state, id, entry, "Readiness deadline expired (health: ${health}). Check logs and the configured port or endpoint.")
}

func record_failure(state, id, entry, message) {
    entry["outcome"] := "failed"
    entry["error"] := message
    state[id] := entry
    save_state(state)
    return failure(message)
}

func port_listener(listeners, port) {
    for listener in listeners {
        if listener["port"] == port {
            return listener
        }
    }
    return null
}

# Preserve old command/route names as an explicit safe failure.
export func control_listeners(services, port, requested_pid, force, confirm) {
    return failure("External listeners are read-only. Stop the application from its own launcher.")
}

export func failure(message) {
    return {"ok": false, "error": message}
}
