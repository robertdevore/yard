# Serve fixed, local assets. The only template value is the URL-safe action token.
export func web_asset(name) {
    return read_file(join_path(env_or("YARD_ROOT", os_getcwd()), "static/${name}"))
}

export func index_html(token) {
    return replace(web_asset("index.html"), "__YARD_TOKEN__", token)
}
