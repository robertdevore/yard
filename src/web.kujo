# Yard :: web
#
# The single-page dashboard, served as one self-contained HTML document (no
# build step, no external assets, no CDN). It is assembled from several string
# fragments because the Kujo lexer caps individual string literals at 8 KB.
#
# Conventions to keep this valid Kujo source:
#   * HTML attributes and JS strings use single quotes (no escaping needed).
#   * JS template-literal interpolations are written \${...} so Kujo emits a
#     literal ${...} rather than interpolating them itself.
#   * The ONLY real Kujo interpolation is ${token}, injected into the page so
#     the browser can authorize destructive actions.

# Assemble the full HTML document, embedding the per-session action token.
export func index_html(token) {
    mut out := ""
    out = out + page_head()
    out = out + page_css()
    out = out + page_body()
    out = out + page_script(token)
    return out
}

func page_head() {
    return "<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>" +
        "<meta name='viewport' content='width=device-width, initial-scale=1'>" +
        "<title>Yard - localhost command center</title>"
}

func page_css() {
    mut s := "<style>"
    s = s + ":root{--bg-primary:#f7f9fc;--bg-secondary:#fff;--bg-tertiary:#eef2f7;--border-color:#dfe5ee;"
    s = s + "--text-primary:#031b4e;--text-secondary:#4f6282;--text-muted:#7b8ba7;--accent-green:#16a085;"
    s = s + "--accent-orange:#b7791f;--accent-red:#d64545;--accent-blue:#0069ff;--accent-purple:#7956d8;"
    s = s + "--accent-cyan:#008f9c;--btn-primary:#0069ff;--btn-primary-hover:#0052cc;--btn-secondary:#fff;"
    s = s + "--btn-secondary-hover:#eef4ff;--btn-danger:#d64545;--shadow:0 4px 16px rgba(3,27,78,.08)}"
    s = s + "*{box-sizing:border-box;border-radius:0!important}body{margin:0;background:var(--bg-primary);color:var(--text-primary);"
    s = s + "font:14px/1.5 -apple-system,BlinkMacSystemFont,'Inter','Segoe UI',Helvetica,Arial,sans-serif}"
    s = s + "a,a:visited{color:var(--accent-blue);text-decoration:none}a:hover{color:var(--accent-cyan);text-decoration:underline}"
    s = s + ".wrap{width:100%;max-width:1600px;margin:0 auto;padding:0 32px 48px}"
    s = s + "header.top{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 0;"
    s = s + "border-bottom:1px solid var(--border-color);margin-bottom:28px;position:sticky;top:0;z-index:10;background:rgba(247,249,252,.94);backdrop-filter:blur(10px)}"
    s = s + ".brand{display:flex;align-items:baseline;gap:12px}"
    s = s + ".brand h1{font-size:23px;font-weight:700;margin:0;color:var(--text-primary);display:flex;align-items:center;gap:8px;letter-spacing:-.02em}"
    s = s + ".brand .sub{color:var(--text-secondary);font-size:12px;border-left:1px solid var(--border-color);padding-left:12px}"
    s = s + ".spacer{flex:1}"
    s = s + ".ctrl{display:flex;align-items:center;gap:8px;color:var(--text-secondary);font-size:13px;white-space:nowrap}"
    s = s + "button{font:inherit}.btn,button{padding:7px 14px;border:1px solid var(--border-color);"
    s = s + "cursor:pointer;font-size:13px;font-weight:500;text-decoration:none;display:inline-flex;align-items:center;gap:4px;"
    s = s + "transition:background .15s;color:var(--text-primary);background:var(--btn-secondary)}"
    s = s + "button:hover,.btn:hover{background:var(--btn-secondary-hover);text-decoration:none}button:disabled{opacity:.35;cursor:not-allowed}"
    s = s + "button.primary{background:var(--btn-primary);border-color:var(--btn-primary);color:#fff}button.primary:hover{background:var(--btn-primary-hover)}"
    s = s + "button.danger{background:var(--btn-danger);border-color:var(--btn-danger);color:#fff}"
    s = s + "button.ghost{background:transparent;color:var(--text-secondary);border-color:transparent}"
    s = s + "button.sm{padding:2px 8px;font-size:12px}.icon{width:16px;height:16px;flex:0 0 auto}.icon.sm{width:14px;height:14px}"
    s = s + "input,select{font:inherit;background:var(--bg-secondary);color:var(--text-primary);"
    s = s + "border:1px solid var(--border-color);padding:9px 12px}input:focus,select:focus{outline:none;border-color:var(--accent-blue);box-shadow:0 0 0 3px rgba(0,105,255,.12)}"
    s = s + ".overview{display:grid;grid-template-columns:1.15fr 1fr 1.15fr;border:1px solid var(--border-color);margin-bottom:16px;background:var(--bg-secondary);box-shadow:var(--shadow)}"
    s = s + ".metric-panel{min-width:0;padding:18px 20px 16px;border-right:1px solid var(--border-color);display:flex;flex-direction:column;gap:12px}.metric-panel:last-child{border-right:0}"
    s = s + ".metric-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.metric-kicker{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text-muted)}"
    s = s + ".metric-value{font-size:34px;line-height:1;font-weight:720;letter-spacing:-.04em;font-variant-numeric:tabular-nums}.metric-unit{font-size:12px;color:var(--text-secondary);margin-top:4px}"
    s = s + ".metric-ratio{font:600 12px/1 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--text-secondary);padding-top:3px}.metric-ratio strong{color:var(--text-primary)}"
    s = s + ".dither-track{height:42px;border:1px solid var(--border-color);display:flex;overflow:hidden;background:#f8fafc}.dither-seg{height:100%;min-width:2px;border:0!important;padding:0!important;display:block;position:relative}"
    s = s + ".dither-seg.managed{color:var(--accent-green);background-color:#eaf8f4!important;background-image:radial-gradient(currentColor 1px,transparent 1.15px)!important;background-size:4px 4px!important}"
    s = s + ".dither-seg.unknown{color:var(--accent-purple);background-color:#f3efff!important;background-image:linear-gradient(135deg,transparent 42%,currentColor 43%,currentColor 52%,transparent 53%)!important;background-size:7px 7px!important}"
    s = s + ".dither-seg.bad{color:var(--accent-red);background-color:#fff0f0!important;background-image:radial-gradient(currentColor 1.15px,transparent 1.25px)!important;background-size:5px 5px!important}"
    s = s + ".dither-seg.rest{background:#f7f9fc!important}.dither-seg:hover{filter:brightness(.94);transform:none}.dither-seg:focus-visible{outline:2px solid currentColor;outline-offset:-2px}"
    s = s + ".metric-legend{display:flex;align-items:center;gap:14px;flex-wrap:wrap}.legend-btn,.mini-stat{border:0!important;background:transparent!important;padding:0!important;color:var(--text-secondary);font-size:11px;font-weight:600}"
    s = s + ".legend-btn:hover,.mini-stat:hover{color:var(--text-primary);background:transparent!important}.legend-key{display:inline-block;width:8px;height:8px;margin-right:5px;border:1px solid currentColor}.legend-key.managed{color:var(--accent-green);background:var(--accent-green)}.legend-key.unknown{color:var(--accent-purple);background:var(--accent-purple)}"
    s = s + ".coverage-grid{display:grid;grid-template-columns:repeat(var(--cells),minmax(12px,1fr));gap:4px;height:42px}.coverage-cell{border:1px solid var(--border-color);background:#f7f9fc}.coverage-cell.on{color:var(--accent-blue);border-color:rgba(0,105,255,.35);background-color:#edf4ff;background-image:radial-gradient(currentColor 1px,transparent 1.15px);background-size:4px 4px}"
    s = s + ".mini-stats{display:flex;gap:16px;flex-wrap:wrap;padding-top:1px}.mini-stat strong{font:700 13px/1 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--text-primary);margin-right:4px}.metric-panel.attention.hot .metric-value{color:var(--accent-red)}"
    s = s + ".toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;gap:12px;flex-wrap:wrap}"
    s = s + ".controls-left{display:flex;gap:8px;flex:1;min-width:280px}.controls-right{display:flex;gap:12px;align-items:center}"
    s = s + ".toolbar input.search{flex:1;min-width:250px}.view-chip{max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
    s = s + "border:1px solid var(--border-color);padding:3px 9px;color:var(--text-secondary);background:var(--bg-secondary);font-size:12px}"
    s = s + ".hidden{display:none!important}.scan-status{font-size:13px;color:var(--text-muted)}"
    s = s + ".banner{padding:10px 14px;margin-bottom:14px;font-size:13px}"
    s = s + ".banner.err{background:rgba(248,81,73,.12);border:1px solid var(--accent-red)}"
    s = s + ".banner.warn{background:rgba(210,153,34,.12);border:1px solid var(--accent-orange)}"
    s = s + ".banner.good{background:rgba(63,185,80,.12);border:1px solid var(--accent-green)}"
    s = s + ".group h2{font-size:12px;text-transform:uppercase;color:var(--text-secondary);letter-spacing:.08em;"
    s = s + "margin:18px 0 10px;border-bottom:1px solid var(--border-color);padding-bottom:6px}"
    return s + page_css2()
}

func page_css2() {
    mut s := ".svc{background:var(--bg-secondary);border:1px solid var(--border-color);"
    s = s + "padding:16px 18px;margin-bottom:10px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;box-shadow:var(--shadow)}"
    s = s + ".svc.stopped{opacity:.72}"
    s = s + ".svc .head{display:flex;align-items:center;gap:10px;flex-wrap:wrap}"
    s = s + ".svc .name{font-weight:600;font-size:15px}"
    s = s + ".svc .meta{color:var(--text-muted);font-size:12.5px;margin-top:6px;display:flex;gap:14px;flex-wrap:wrap}"
    s = s + ".svc .meta b{color:var(--text-primary);font-weight:500}"
    s = s + ".svc .cmd{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;"
    s = s + "color:var(--text-muted);margin-top:6px;word-break:break-all}"
    s = s + ".actions{display:flex;gap:6px;flex-wrap:wrap;align-items:flex-start;justify-content:flex-end}"
    s = s + ".actions button{padding:4px;background:transparent!important;border-color:transparent!important;box-shadow:none;color:var(--text-secondary);transition:color .15s,transform .15s,filter .15s}"
    s = s + ".actions button:hover{background:transparent!important;transform:translateY(-1px) scale(1.12);filter:brightness(.78)}"
    s = s + ".actions button:focus-visible{outline:1px solid currentColor;outline-offset:2px}"
    s = s + ".actions .action-open{color:var(--accent-blue)}.actions .action-copy{color:var(--accent-cyan)}"
    s = s + ".actions .action-start{color:var(--accent-green)}.actions .action-restart{color:var(--accent-purple)}"
    s = s + ".actions .action-logs{color:var(--accent-orange)}.actions .action-inspect{color:var(--accent-blue)}"
    s = s + ".actions .action-stop,.actions .action-force{color:var(--accent-red)}.actions .action-claim{color:var(--accent-cyan)}"
    s = s + ".actions button:disabled{transform:none;filter:none}.actions .icon{width:17px;height:17px}"
    s = s + ".badge{display:inline-block;padding:1px 6px;font-size:11px;font-weight:500;white-space:nowrap}"
    s = s + ".badge.managed{background:#e6f7f5;color:#007f86}.badge.unknown{background:#f0ebff;color:var(--accent-purple)}"
    s = s + ".badge.sensitive{background:#fff5df;color:var(--accent-orange)}.badge.untracked{background:#eef2f7;color:var(--text-secondary)}"
    s = s + ".dot{display:inline-block;width:8px;height:8px;margin-right:5px;vertical-align:middle}"
    s = s + ".h-healthy,.s-running{color:var(--accent-green)}.h-healthy .dot,.s-running .dot{background:var(--accent-green)}"
    s = s + ".h-unhealthy{color:var(--accent-red)}.h-unhealthy .dot{background:var(--accent-red)}"
    s = s + ".h-timeout{color:var(--accent-orange)}.h-timeout .dot{background:var(--accent-orange)}"
    s = s + ".h-not_http,.h-unknown,.s-stopped{color:var(--text-muted)}.h-not_http .dot,.h-unknown .dot,.s-stopped .dot{background:var(--text-muted)}"
    s = s + ".empty,.loading-state{text-align:center;color:var(--text-secondary);padding:60px 20px}"
    s = s + ".loading-state{display:flex;flex-direction:column;align-items:center;gap:12px}"
    s = s + ".loading-state strong{color:var(--text-primary);font-size:15px}.loading-state span{color:var(--text-muted);font-size:13px}"
    s = s + ".loading-orbit{width:42px;height:42px;color:var(--accent-blue);animation:spin .9s linear infinite}"
    s = s + ".loading-orbit .track{opacity:.18}.loading-orbit .arc{stroke:var(--accent-cyan);stroke-linecap:round}"
    s = s + ".spin-icon{animation:spin .8s linear infinite}"
    s = s + "@keyframes spin{to{transform:rotate(360deg)}}"
    s = s + ".modal{position:fixed;inset:0;background:rgba(0,0,0,.6);display:none;align-items:center;justify-content:center;z-index:50}"
    s = s + ".modal.open{display:flex}.modal .box{background:var(--bg-secondary);border:1px solid var(--border-color);"
    s = s + "padding:20px;max-width:680px;width:90%;max-height:80vh;overflow:auto;box-shadow:var(--shadow)}"
    s = s + ".modal h3{margin:0 0 12px}.modal pre{background:var(--bg-primary);border:1px solid var(--border-color);"
    s = s + "padding:12px;overflow:auto;font-size:12px;max-height:50vh}"
    s = s + ".modal .row{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}"
    s = s + ".foot{color:var(--text-muted);font-size:12px;text-align:center;margin-top:24px}"
    s = s + ".toast{position:fixed;bottom:20px;right:20px;padding:10px 20px;color:#fff;font-size:14px;z-index:200}"
    s = s + ".toast-good{background:var(--accent-green)}.toast-err{background:var(--accent-red)}"
    s = s + "@media(max-width:768px){.wrap{padding:0 12px 32px}header.top{flex-direction:column;align-items:stretch}.brand{justify-content:space-between}"
    s = s + ".controls-left{flex-direction:column;width:100%}.toolbar input.search{min-width:100%}.overview{grid-template-columns:1fr}.metric-panel{border-right:0;border-bottom:1px solid var(--border-color)}.metric-panel:last-child{border-bottom:0}.svc{grid-template-columns:1fr}.actions{justify-content:flex-start}}"
    return s + "</style></head>"
}

func page_body() {
    mut s := "<body><div class='wrap'>"
    s = s + "<header class='top'><div class='brand'><h1>Yard</h1>"
    s = s + "<span class='sub'>localhost command center</span></div><div class='spacer'></div>"
    s = s + "<label class='ctrl'><input type='checkbox' id='health' checked> health probes</label>"
    s = s + "<label class='ctrl'><input type='checkbox' id='auto'> auto-refresh</label>"
    s = s + "<button class='primary' id='refresh'>Refresh</button></header>"
    s = s + "<div id='banners'></div>"
    s = s + "<div class='banner warn' id='flash' style='display:none'></div>"
    s = s + "<div class='overview' id='cards' aria-label='Service overview'></div>"
    s = s + "<div class='toolbar'><div class='controls-left'><input class='search' id='search' placeholder='Search services... (name, port, group, command, health)'>"
    s = s + "<select id='fstatus'><option value='all'>All Services</option>"
    s = s + "<option value='running'>Running</option><option value='stopped'>Stopped</option>"
    s = s + "<option value='managed'>Managed</option><option value='unknown'>Unknown</option>"
    s = s + "<option value='sensitive'>Sensitive</option><option value='healthy'>Healthy</option>"
    s = s + "<option value='unhealthy'>Unhealthy</option><option value='untracked'>Untracked</option></select>"
    s = s + "<select id='fgroup'><option value=''>All Groups</option></select>"
    s = s + "<select id='sort'><option value='port'>Sort: port</option>"
    s = s + "<option value='name'>Sort: name</option><option value='status'>Sort: status</option>"
    s = s + "<option value='group'>Sort: group</option></select>"
    s = s + "<button id='share' title='Copy current view link'>Share View</button><button class='ghost' id='reset' title='Reset filters'>Reset</button></div>"
    s = s + "<div class='controls-right'><span id='filtered-count' class='scan-status'></span><span id='view-chip' class='view-chip hidden'></span></div></div>"
    s = s + "<div id='list'><div class='loading-state' role='status' aria-live='polite'>"
    s = s + "<svg class='loading-orbit' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'>"
    s = s + "<circle class='track' cx='12' cy='12' r='9' stroke='currentColor' stroke-width='2'></circle>"
    s = s + "<path class='arc' d='M21 12a9 9 0 0 0-9-9' stroke-width='2'></path></svg>"
    s = s + "<strong>Scanning localhost services</strong><span>Checking ports, ownership, and health signals...</span></div></div>"
    s = s + "<div class='foot'>Yard binds only to 127.0.0.1. Managed commands come solely from your config file.</div>"
    s = s + "</div>"
    s = s + "<div class='modal' id='modal'><div class='box' id='modalbox'></div></div>"
    s = s + "</body>"
    return s
}

func page_script(token) {
    mut s := "<script>"
    s = s + "const YARD_TOKEN='${token}';"
    s = s + page_js_core()
    s = s + page_js_render()
    s = s + page_js_actions()
    s = s + "boot();</script></html>"
    return s
}

func page_js_core() {
    mut s := "let DATA={services:[],summary:{},config:{},scan_error:null,ok:true};"
    s = s + "let timer=null;let viewReady=false;const Q=String.fromCharCode(34);"
    s = s + "const $=function(id){return document.getElementById(id);};"
    s = s + "function esc(v){return String(v==null?'':v).split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;').split(Q).join('&quot;').split(\"'\").join('&#39;');}"
    s = s + "async function getJSON(u){const r=await fetch(u);return await r.json();}"
    s = s + "async function postJSON(u,b){const body=Object.assign({token:YARD_TOKEN},b||{});"
    s = s + "const r=await fetch(u,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});return await r.json();}"
    s = s + "function flash(msg,kind){const b=$('flash');if(!b)return;b.className='banner '+(kind||'warn');b.textContent=msg;b.style.display='block';"
    s = s + "clearTimeout(flash._t);flash._t=setTimeout(function(){b.style.display='none';},4000);}"
    # Keep the dashboard self-contained by using its existing Lucide icon subset.
    s = s + "function icon(n,sm){const c=(sm?'icon sm':'icon')+(n==='loader'?' spin-icon':'');const m={yard:'<path d=\"M3 12h18\"/><path d=\"M5 12V7l7-4 7 4v5\"/><path d=\"M7 12v8\"/><path d=\"M17 12v8\"/><path d=\"M10 20v-5h4v5\"/>',refresh:'<path d=\"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8\"/><path d=\"M21 3v5h-5\"/><path d=\"M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16\"/><path d=\"M8 16H3v5\"/>',loader:'<path d=\"M21 12a9 9 0 1 1-6.219-8.56\"/>',copy:'<rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" ry=\"2\"/><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"/>',play:'<polygon points=\"6 3 20 12 6 21 6 3\"/>',restart:'<path d=\"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8\"/><path d=\"M21 3v5h-5\"/><path d=\"M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16\"/><path d=\"M8 16H3v5\"/>',logs:'<path d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"/><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"/><path d=\"M10 9H8\"/><path d=\"M16 13H8\"/><path d=\"M16 17H8\"/>',inspect:'<path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/>',stop:'<circle cx=\"12\" cy=\"12\" r=\"10\"/><rect width=\"8\" height=\"8\" x=\"8\" y=\"8\" rx=\"1\"/>',force:'<path d=\"M7.86 2h8.28L22 7.86v8.28L16.14 22H7.86L2 16.14V7.86Z\"/><path d=\"M12 8v5\"/><path d=\"M12 17h.01\"/>',claim:'<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M8 12h8\"/><path d=\"M12 8v8\"/>',share:'<path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\"/><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\"/>',reset:'<path d=\"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8\"/><path d=\"M3 3v5h5\"/>',external:'<path d=\"M15 3h6v6\"/><path d=\"M10 14 21 3\"/><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/>'};return '<svg class=\"'+c+'\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">'+(m[n]||'')+'</svg>';}"
    s = s + "function decorateStatic(){$('refresh').innerHTML=icon('refresh')+'Refresh';$('share').innerHTML=icon('share')+'Share View';$('reset').innerHTML=icon('reset')+'Reset';const h=document.querySelector('.brand h1');if(h&&h.dataset.i!=='1'){h.innerHTML=icon('yard')+'Yard';h.dataset.i='1';}}"
    s = s + "function loadingHtml(){return `<div class='loading-state' role='status' aria-live='polite'><svg class='loading-orbit' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'><circle class='track' cx='12' cy='12' r='9' stroke='currentColor' stroke-width='2'></circle><path class='arc' d='M21 12a9 9 0 0 0-9-9' stroke-width='2'></path></svg><strong>Scanning localhost services</strong><span>Checking ports, ownership, and health signals...</span></div>`;}"
    s = s + "function setRefreshBusy(on){const b=$('refresh');if(!b)return;b.disabled=!!on;b.innerHTML=(on?icon('loader')+'Scanning...':icon('refresh')+'Refresh');}"
    s = s + "async function loadData(showLoading){const wh=$('health').checked?'1':'0';if(showLoading){$('list').innerHTML=loadingHtml();setRefreshBusy(true);}try{DATA=await getJSON('/api/services?health='+wh);render();viewReady=true;}"
    s = s + "catch(e){$('list').innerHTML=`<div class='banner err'>Could not reach the Yard API. Is the server still running?</div>`;}finally{if(showLoading)setRefreshBusy(false);}}"
    s = s + "function boot(){decorateStatic();applyViewFromUrl();$('refresh').addEventListener('click',function(){loadData(true);});"
    s = s + "$('health').addEventListener('change',function(){loadData(true);});"
    s = s + "$('auto').addEventListener('change',function(){if(this.checked){timer=setInterval(function(){loadData(false);},5000);}else{clearInterval(timer);}});"
    s = s + "['search','fgroup','fstatus','sort'].forEach(function(id){$(id).addEventListener('input',render);});"
    s = s + "$('share').addEventListener('click',copyCurrentViewLink);$('reset').addEventListener('click',resetView);"
    s = s + "window.addEventListener('popstate',function(){applyViewFromUrl();render(false);});"
    s = s + "$('cards').addEventListener('click',function(e){const b=e.target.closest('[data-summary-filter]');if(!b)return;$('fstatus').value=b.dataset.summaryFilter;render();$('list').scrollIntoView({behavior:'smooth',block:'start'});});"
    s = s + "$('list').addEventListener('click',onListClick);"
    s = s + "$('modal').addEventListener('click',function(e){if(e.target.id==='modal')closeModal();});"
    s = s + "loadData(false);}"
    return s
}

func page_js_render() {
    mut s := "function render(){DATA.services.forEach(function(s,i){s._i=i;});"
    s = s + "$('banners').innerHTML=bannersHtml();$('cards').innerHTML=cardsHtml();syncGroups();if(!viewReady)applyViewFromUrl();"
    s = s + "const arr=filtered();$('list').innerHTML=listHtml(arr);updateViewSummary(arr.length);if(viewReady)updateUrlFromView();}"
    s = s + "function bannersHtml(){let h='';const c=DATA.config||{};"
    s = s + "if(DATA.scan_error){h+=`<div class='banner err'>Scanner: \${esc(DATA.scan_error)}</div>`;}"
    s = s + "(c.errors||[]).forEach(function(e){h+=`<div class='banner err'>Config error: \${esc(e)}</div>`;});"
    s = s + "(c.warnings||[]).forEach(function(w){h+=`<div class='banner warn'>Config: \${esc(w)}</div>`;});"
    s = s + "if(c.exists===false){h+=`<div class='banner warn'>No config at \${esc(c.path)} - showing detected ports only. Add managed services to start/restart from here.</div>`;}"
    s = s + "return h;}"
    s = s + "function metricPct(n,total){return total>0?Math.max(0,Math.min(100,(n/total)*100)):0;}"
    s = s + "function coverageCells(on,total){const count=Math.max(1,Math.min(total||1,12));const lit=total>12?Math.round(metricPct(on,total)*count/100):Math.min(on,count);let h='';for(let i=0;i<count;i++)h+=`<span class='coverage-cell \${i<lit?'on':''}'></span>`;return `<div class='coverage-grid' style='--cells:\${count}' role='img' aria-label='\${on} of \${total} managed services running'>\${h}</div>`;}"
    s = s + "function filterBtn(filter,label,value,cls){return `<button class='\${cls||'mini-stat'}' data-summary-filter='\${filter}'><strong>\${value}</strong>\${label}</button>`;}"
    s = s + "function cardsHtml(){const m=DATA.summary||{};const run=m.running_ports||0;const managed=m.managed_running||0;const unknown=m.unknown_ports||0;const total=m.managed_total||0;const unhealthy=m.unhealthy||0;"
    s = s + "const mw=metricPct(managed,run);const uw=metricPct(unknown,run);const badw=metricPct(unhealthy,run);const restw=Math.max(0,100-badw);"
    s = s + "let fleet=`<section class='metric-panel'><div class='metric-head'><div><div class='metric-kicker'>Fleet</div><div class='metric-value'>\${run}</div><div class='metric-unit'>active listeners</div></div><div class='metric-ratio'><strong>\${Math.round(mw)}</strong>% managed</div></div>`;"
    s = s + "fleet+=`<div class='dither-track' role='img' aria-label='\${managed} managed and \${unknown} unknown listeners'><button class='dither-seg managed' style='width:\${mw}%' data-summary-filter='managed' aria-label='Show \${managed} managed listeners'></button><button class='dither-seg unknown' style='width:\${uw}%' data-summary-filter='unknown' aria-label='Show \${unknown} unknown listeners'></button></div>`;"
    s = s + "fleet+=`<div class='metric-legend'><button class='legend-btn' data-summary-filter='managed'><span class='legend-key managed'></span>\${managed} managed</button><button class='legend-btn' data-summary-filter='unknown'><span class='legend-key unknown'></span>\${unknown} unknown</button></div></section>`;"
    s = s + "let coverage=`<section class='metric-panel'><div class='metric-head'><div><div class='metric-kicker'>Managed coverage</div><div class='metric-value'>\${managed}<span class='metric-unit'> / \${total}</span></div><div class='metric-unit'>services online</div></div><div class='metric-ratio'><strong>\${Math.round(metricPct(managed,total))}</strong>% online</div></div>`;"
    s = s + "coverage+=coverageCells(managed,total)+`<div class='mini-stats'>\${filterBtn('managed','managed',total)}\${filterBtn('stopped','stopped',m.stopped_managed||0)}</div></section>`;"
    s = s + "let attention=`<section class='metric-panel attention \${unhealthy?'hot':''}'><div class='metric-head'><div><div class='metric-kicker'>Attention</div><div class='metric-value'>\${unhealthy}</div><div class='metric-unit'>unhealthy or timing out</div></div><div class='metric-ratio'><strong>\${Math.round(badw)}</strong>% of fleet</div></div>`;"
    s = s + "attention+=`<div class='dither-track' role='img' aria-label='\${unhealthy} unhealthy of \${run} listeners'><button class='dither-seg bad' style='width:\${badw}%' data-summary-filter='unhealthy' aria-label='Show \${unhealthy} unhealthy listeners'></button><span class='dither-seg rest' style='width:\${restw}%'></span></div>`;"
    s = s + "attention+=`<div class='mini-stats'>\${filterBtn('sensitive','sensitive',m.sensitive||0)}\${filterBtn('untracked','untracked',m.untracked||0)}</div></section>`;return fleet+coverage+attention;}"
    s = s + "function syncGroups(){const sel=$('fgroup');const cur=sel.value;const gs=[];"
    s = s + "DATA.services.forEach(function(s){if(gs.indexOf(s.group)<0)gs.push(s.group);});gs.sort();"
    s = s + "let h=`<option value=''>All Groups</option>`;gs.forEach(function(g){h+=`<option value='\${esc(g)}'>\${esc(g)}</option>`;});"
    s = s + "sel.innerHTML=h;sel.value=cur;}"
    s = s + "function filtered(){const q=$('search').value.toLowerCase();const g=$('fgroup').value;const st=$('fstatus').value;"
    s = s + "let arr=DATA.services.filter(function(s){if(g&&s.group!==g)return false;"
    s = s + "if(st==='running'&&s.state!=='running')return false;if(st==='stopped'&&s.state!=='stopped')return false;"
    s = s + "if(st==='managed'&&!s.managed)return false;if(st==='unknown'&&s.managed)return false;"
    s = s + "if(st==='sensitive'&&!s.sensitive)return false;if(st==='healthy'&&s.health_status!=='healthy')return false;"
    s = s + "if(st==='unhealthy'&&!(s.health_status==='unhealthy'||s.health_status==='timeout'))return false;"
    s = s + "if(st==='untracked'&&!s.untracked)return false;if(st&&st!=='all'&&st!==''&&['running','stopped','managed','unknown','sensitive','healthy','unhealthy','untracked'].indexOf(st)<0)return false;"
    s = s + "if(q){const hay=((s.name||'')+' '+s.port+' '+(s.command||'')+' '+(s.group||'')+' '+(s.id||'')+' '+(s.url||'')+' '+(s.known_label||'')+' '+(s.health_status||'')).toLowerCase();if(hay.indexOf(q)<0)return false;}return true;});"
    s = s + "const so=$('sort').value;arr.sort(function(a,b){if(so==='name')return (''+a.name).localeCompare(''+b.name);"
    s = s + "if(so==='group')return (''+a.group).localeCompare(''+b.group)||a.port-b.port;"
    s = s + "if(so==='status')return rank(a)-rank(b)||a.port-b.port;return a.port-b.port;});return arr;}"
    s = s + "function rank(s){if(s.health_status==='unhealthy'||s.health_status==='timeout')return 0;"
    s = s + "if(s.untracked)return 1;if(s.state==='running')return 2;return 3;}"
    s = s + "function applyViewFromUrl(){const p=new URLSearchParams(window.location.search);$('fstatus').value=p.get('status')||p.get('filter')||'all';$('fgroup').value=p.get('group')||p.get('project')||'';$('search').value=p.get('q')||p.get('search')||'';$('sort').value=p.get('sort')||'port';}"
    s = s + "function updateUrlFromView(){const p=new URLSearchParams();const st=$('fstatus').value;const g=$('fgroup').value;const q=$('search').value.trim();const so=$('sort').value;if(st&&st!=='all')p.set('status',st);if(g)p.set('group',g);if(q)p.set('q',q);if(so&&so!=='port')p.set('sort',so);const qs=p.toString();const next=window.location.pathname+(qs?'?'+qs:'');if(next!==window.location.pathname+window.location.search)window.history.replaceState({},'',next);}"
    s = s + "function resetView(){$('fstatus').value='all';$('fgroup').value='';$('search').value='';$('sort').value='port';render();}"
    s = s + "async function copyCurrentViewLink(){updateUrlFromView();const href=window.location.href;try{await navigator.clipboard.writeText(href);flash('View link copied','good');}catch(e){prompt('Copy view link:',href);}}"
    s = s + "function updateViewSummary(n){const count=$('filtered-count');if(count)count.textContent=n+' of '+DATA.services.length+' services';const chip=$('view-chip');if(!chip)return;const parts=[];const st=$('fstatus').value;const g=$('fgroup').value;const q=$('search').value.trim();if(st&&st!=='all')parts.push(st);if(g)parts.push('group: '+g);if(q)parts.push('search: '+q);chip.textContent=parts.join(' / ');chip.classList.toggle('hidden',parts.length===0);}"
    return s + page_js_render2()
}

func page_js_render2() {
    mut s := "function healthText(s){if(s.state==='stopped')return 'Not running';let t=s.health_status;let x='';"
    s = s + "if(s.http_status)x+=' '+s.http_status;if(s.response_ms!=null)x+=' '+s.response_ms+'ms';return t+x;}"
    s = s + "function listHtml(arr){if(!arr.length)return `<div class='empty'>No localhost services match. Add managed services to your Yard config or start a dev server.</div>`;"
    s = s + "let groups={};arr.forEach(function(s){(groups[s.group]=groups[s.group]||[]).push(s);});"
    s = s + "let h='';Object.keys(groups).sort().forEach(function(g){h+=`<div class='group'><h2>\${esc(g)}</h2>`;"
    s = s + "groups[g].forEach(function(s){h+=svcCard(s);});h+='</div>';});return h;}"
    s = s + "function svcCard(s){let cls='svc';if(!s.managed)cls+=' unknown';if(s.sensitive)cls+=' sensitive';if(s.state==='stopped')cls+=' stopped';"
    s = s + "const sc=s.state==='running'?'s-running':'s-stopped';const hc='h-'+s.health_status;"
    s = s + "let badges=s.managed?`<span class='badge managed'>managed</span>`:`<span class='badge unknown'>unknown</span>`;"
    s = s + "if(s.sensitive)badges+=`<span class='badge sensitive'>sensitive</span>`;"
    s = s + "if(s.untracked)badges+=`<span class='badge untracked' title='Running, but not started or tracked by Yard'>untracked</span>`;"
    s = s + "const lbl=s.known_label?` &middot; \${esc(s.known_label)}`:'';"
    s = s + "let meta=`<span class='\${sc}'><span class='dot'></span>\${s.state==='running'?'Running':'Stopped'}</span>`;"
    s = s + "meta+=`<span>Port <b>\${s.port}</b>\${lbl}</span>`;"
    s = s + "meta+=`<span class='\${hc}'><span class='dot'></span>\${esc(healthText(s))}</span>`;"
    s = s + "if(s.pid)meta+=`<span>PID <b>\${s.pid}</b></span>`;"
    s = s + "if(s.restart_count)meta+=`<span>restarts <b>\${s.restart_count}</b></span>`;"
    s = s + "meta+=`<span><a href='\${esc(s.url)}' target='_blank' rel='noopener'>\${esc(s.url)}</a></span>`;"
    s = s + "const cmd=s.command?`<div class='cmd'>\${esc(s.command)}</div>`:'';"
    s = s + "return `<div class='\${cls}'><div><div class='head'><span class='name'>\${esc(s.name)}</span>\${badges}</div>`"
    s = s + "+`<div class='meta'>\${meta}</div>\${cmd}</div><div class='actions'>\${actionBtns(s)}</div></div>`;}"
    s = s + "function btn(label,act,i,cls,ic){return `<button class='sm action-icon action-\${act} \${cls||''}' data-act='\${act}' data-idx='\${i}' title='\${esc(label)}' aria-label='\${esc(label)}'>\${icon(ic||act,true)}</button>`;}"
    s = s + "function actionBtns(s){const a=s.actions||{};const i=s._i;let h='';"
    s = s + "if(a.open)h+=btn('Open','open',i,'','external');if(a.copy)h+=btn('Copy','copy',i);"
    s = s + "if(a.start)h+=btn('Start','start',i,'primary','play');if(a.restart)h+=btn('Restart','restart',i,'','restart');"
    s = s + "if(a.logs)h+=btn('Logs','logs',i);if(a.inspect)h+=btn('Inspect','inspect',i);"
    s = s + "if(a.stop)h+=btn('Stop','stop',i,'danger','stop');if(a.force_stop)h+=btn('Force stop','force',i,'danger','force');"
    s = s + "if(a.claim)h+=btn('Claim','claim',i);return h;}"
    return s
}

func page_js_actions() {
    mut s := "function onListClick(e){const b=e.target.closest('button[data-act]');if(!b)return;"
    s = s + "const s=DATA.services[+b.dataset.idx];if(!s)return;handleAction(b.dataset.act,s);}"
    s = s + "function handleAction(act,s){"
    s = s + "if(act==='open'){window.open(s.open_url,'_blank');return;}"
    s = s + "if(act==='copy'){navigator.clipboard.writeText(s.url).then(function(){flash('Copied '+s.url,'good');});return;}"
    s = s + "if(act==='inspect'){modalInspect(s);return;}"
    s = s + "if(act==='logs'){modalLogs(s);return;}"
    s = s + "if(act==='claim'){modalClaim(s);return;}"
    s = s + "if(act==='start'){doAction('/api/services/'+encodeURIComponent(s.id)+'/start',{},'start '+s.name);return;}"
    s = s + "if(act==='restart'){if(s.sensitive){confirmThen('Restart sensitive service '+s.name+'?','Restart',function(){doAction('/api/services/'+encodeURIComponent(s.id)+'/restart',{confirm:true},'restart '+s.name);});}"
    s = s + "else{doAction('/api/services/'+encodeURIComponent(s.id)+'/restart',{},'restart '+s.name);}return;}"
    s = s + "if(act==='stop'||act==='force'){const force=act==='force';"
    s = s + "const url=s.id?('/api/services/'+encodeURIComponent(s.id)+'/stop'):('/api/processes/'+s.pid+'/stop');"
    s = s + "const need=force||s.sensitive;const label=(force?'Force stop ':'Stop ')+s.name+(s.sensitive?' (sensitive)':'');"
    s = s + "if(need){confirmThen(label+'?',force?'Force stop':'Stop',function(){doAction(url,{force:force,confirm:true},label);});}"
    s = s + "else{doAction(url,{force:false},label);}return;}}"
    s = s + "async function doAction(url,body,label){try{let res=await postJSON(url,body);"
    s = s + "if(res&&res.needs_confirm){confirmThen((res.error||'Confirm action')+'?','Confirm',function(){doAction(url,Object.assign({confirm:true},body),label);});return;}"
    s = s + "if(res&&res.ok){flash('OK: '+label,'good');}else{flash('Failed: '+label+' - '+((res&&res.error)||'unknown error'),'err');}}"
    s = s + "catch(e){flash('Error: '+label,'err');}setTimeout(loadData,400);}"
    s = s + "function openModal(html){$('modalbox').innerHTML=html;$('modal').classList.add('open');}"
    s = s + "function closeModal(){$('modal').classList.remove('open');}"
    s = s + "function bindClose(){const b=$('mclose');if(b)b.addEventListener('click',closeModal);}"
    s = s + "function confirmThen(msg,okLabel,fn){openModal(`<h3>Confirm</h3><p>\${esc(msg)}</p><div class='row'><button id='mcancel'>Cancel</button><button id='mok' class='danger'>\${esc(okLabel)}</button></div>`);"
    s = s + "$('mcancel').addEventListener('click',closeModal);$('mok').addEventListener('click',function(){closeModal();fn();});}"
    s = s + "function modalInspect(s){openModal(`<h3>\${esc(s.name)}</h3><pre>\${esc(JSON.stringify(s,null,2))}</pre><div class='row'><button id='mclose'>Close</button></div>`);bindClose();}"
    s = s + "async function modalLogs(s){openModal(`<h3>Logs - \${esc(s.name)}</h3><pre id='logpre'>Loading...</pre><div class='row'><button id='mclose'>Close</button></div>`);bindClose();"
    s = s + "try{const d=await getJSON('/api/services/'+encodeURIComponent(s.id)+'/logs');const t=(d.lines&&d.lines.length)?d.lines.join('\\n'):'(no logs captured yet)';$('logpre').textContent=t;}"
    s = s + "catch(e){$('logpre').textContent='Failed to load logs';}}"
    s = s + "function modalClaim(s){const entry={id:'service-'+s.port,name:'Service on '+s.port,group:'Claimed',port:s.port,cwd:'~/path/to/project',start:'<your start command>',health:s.url,open:s.url};"
    s = s + "openModal(`<h3>Claim port \${s.port}</h3><p>Add this to your Yard config services array, then edit cwd and start:</p><pre>\${esc(JSON.stringify(entry,null,2))}</pre><div class='row'><button id='mclose'>Close</button></div>`);bindClose();}"
    return s
}
