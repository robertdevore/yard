# The helper owns POSIX session operations. Control requests use only the address
# and capability saved before launch, never a PID supplied by a client.
export func supervisor(action, spec, timeout) {
    try {
        helper := env_or("YARD_SUPERVISOR", "bin/supervisor.py")
        r := spawn_process(["python3", helper, action], {
            "stdin": to_json(spec), "timeout_ms": timeout, "max_output_bytes": 524288
        })
        if r.timed_out {
            return {"ok": false, "error": "Yard supervisor did not respond before the deadline"}
        }
        if r.stdout_truncated {
            return {"ok": false, "error": "Yard supervisor response exceeded its size limit"}
        }
        if trim(r.stdout) == "" {
            return {"ok": false, "error": "Could not run Yard's Python 3 supervisor"}
        }
        result := parse_json(r.stdout)
        if type(result) != "dict" || type(get(result, "ok")) != "bool" || (r.exitcode != 0 && result["ok"]) {
            return {"ok": false, "error": "Yard supervisor returned an invalid response"}
        }
        return result
    } except e {
        return {"ok": false, "error": "Could not run Yard's Python 3 supervisor"}
    }
}

export func absolute_path(path) {
    if starts_with(path, "/") {
        return path
    }
    return join_path(os_getcwd(), path)
}
