# Parse the local registry and normalize validated fields. The lifecycle
# controller runs only commands that have been saved in this registry.

from src.util import truthy, includes, expand_home

# Resolve the config path from the CLI override, environment, or user config.
export func resolve_path(explicit) {
    if type(explicit) != "null" && "${explicit}" != "" {
        return expand_home("${explicit}")
    }
    return expand_home(env_or("YARD_CONFIG", join_path(env_or("HOME", "."), ".config/yard/yard.config.json")))
}

# Load and validate the config at `path`. Always returns a structured result:
#   { "path": str, "exists": bool, "services": [ServiceConfig...],
#     "errors": [str...], "warnings": [str...] }
# `services` only ever contains entries that passed validation, so callers can
# trust validated IDs and normalized fields.
export func load(path) {
    result := {
        "path": path,
        "exists": false,
        "services": [],
        "errors": [],
        "warnings": [],
        "raw": {"services": []}
    }
    if file_exists(path) == false {
        return result
    }
    result["exists"] := true

    mut raw := null
    try {
        raw = read_file(path)
    } except e {
        result["errors"] := ["could not read config: ${e}"]
        return result
    }
    mut parsed := null
    try {
        parsed = parse_json(raw)
    } except e {
        result["errors"] := push(result["errors"], "config is not valid JSON: ${e}")
        return result
    }
    if type(parsed) != "dict" && type(parsed) != "array" {
        result["errors"] := push(result["errors"], "config is not valid JSON (could not parse ${path})")
        return result
    }

    result["raw"] := parsed
    raw_services := extract_services(parsed)
    if type(raw_services) != "array" {
        result["errors"] := push(result["errors"], "config 'services' must be an array")
        return result
    }

    validated := validate_services(raw_services)
    mut services := []
    for service in validated["services"] {
        cwd := service["cwd"]
        if cwd == null {
            cwd = "."
        }
        if starts_with(cwd, "/") == false {
            cwd = join_path(dirname(path), cwd)
        }
        service["cwd"] := cwd
        services = push(services, service)
    }
    result["services"] := services
    result["errors"] := validated["errors"]
    result["warnings"] := validated["warnings"]
    return result
}

# Accept either {"services": [...]} or a bare top-level array of services.
export func extract_services(parsed) {
    if type(parsed) == "array" {
        return parsed
    }
    if truthy(has_key(parsed, "services")) {
        return parsed["services"]
    }
    return []
}

# Validate the raw service entries, normalizing fields and collecting problems.
export func validate_services(raw_services) {
    mut services := []
    mut errors := []
    mut warnings := []
    mut seen_ids := {}
    mut seen_ports := {}
    mut i := 0
    n := len(raw_services)
    while i < n {
        entry := raw_services[i]
        idx := i
        i = i + 1
        if type(entry) != "dict" {
            errors = push(errors, "service #${idx} is not an object")
            continue
        }
        if truthy(has_key(entry, "id")) == false {
            errors = push(errors, "service #${idx} is missing required 'id'")
            continue
        }
        id := entry["id"]
        if type(id) != "string" || valid_id(id) == false {
            errors = push(errors, "service #${idx} has an invalid 'id' (use letters, numbers, dot, underscore, or hyphen)")
            continue
        }
        port_value := get(entry, "port")
        port := normalize_port(port_value)
        if port_value != null && type(port) != "int" {
            errors = push(errors, "service '${id}' has an invalid 'port' (must be 1-65535)")
            continue
        }
        problem := validate_fields(entry, port)
        if problem != null {
            errors = push(errors, "Service '${id}': ${problem}")
            continue
        }
        if has_key(seen_ids, id) == 1 {
            warnings = push(warnings, "duplicate service id '${id}' (later entry ignored)")
            continue
        }
        if port != null && has_key(seen_ports, "${port}") == 1 {
            warnings = push(warnings, "duplicate configured port ${port} (service '${id}' ignored)")
            continue
        }
        seen_ids[id] := true
        if port != null {
            seen_ports["${port}"] := true
        }
        services = push(services, normalize_service(entry, id, port))
    }
    return {"services": services, "errors": errors, "warnings": warnings}
}

func normalize_port(value) {
    mut port := null
    if type(value) == "int" {
        port = value
    } else {
        if type(value) == "string" {
            if numeric_string(value) {
                port = parse_int(value)
            }
        }
    }
    if type(port) == "int" && port >= 1 && port <= 65535 {
        return port
    }
    return null
}

func numeric_string(value) {
    s := "${value}"
    if s == "" {
        return false
    }
    mut ns_i := 0
    ns_n := len(s)
    while ns_i < ns_n {
        ch := substring(s, ns_i, ns_i + 1)
        if truthy(contains("0123456789", ch)) == false {
            return false
        }
        ns_i = ns_i + 1
    }
    return true
}

func valid_id(id) {
    if id == "" || id == "." || id == ".." || len(id) > 80 {
        return false
    }
    allowed := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
    mut vi_i := 0
    vi_n := len(id)
    while vi_i < vi_n {
        ch := substring(id, vi_i, vi_i + 1)
        if truthy(contains(allowed, ch)) == false {
            return false
        }
        vi_i = vi_i + 1
    }
    return true
}

# Build a normalized ServiceConfig with predictable keys, defaulting optional
# fields to null/sensible values and expanding ~ in cwd.
func normalize_service(entry, id, port) {
    return {
        "id": id,
        "name": opt(entry, "name", id),
        "group": opt(entry, "group", "Ungrouped"),
        "port": port,
        "cwd": expand_home(opt(entry, "cwd", null)),
        "favorite": bool_opt(entry, "favorite", false),
        "enabled": bool_opt(entry, "enabled", true),
        "runtime": opt(entry, "runtime", null),
        "executable": opt(entry, "executable", null),
        "env": list_opt(entry, "env"),
        "health_type": opt(entry, "health_type", default_health(entry, port)),
        "probe_timeout_ms": opt(entry, "probe_timeout_ms", 400),
        "expected_status": opt(entry, "expected_status", null),
        "startup_timeout": opt(entry, "startup_timeout", 3),
        "shutdown_timeout": opt(entry, "shutdown_timeout", 3),
        "start": opt(entry, "start", null),
        "stop": opt(entry, "stop", null),
        "health": opt(entry, "health", null),
        "open": opt(entry, "open", null),
        "description": opt(entry, "description", null),
        "sensitive": bool_opt(entry, "sensitive", false),
        "tags": list_opt(entry, "tags")
    }
}

func opt(entry, key, fallback) {
    if truthy(has_key(entry, key)) {
        v := entry[key]
        if type(v) == "null" {
            return fallback
        }
        return v
    }
    return fallback
}

func bool_opt(entry, key, fallback) {
    if truthy(has_key(entry, key)) {
        return truthy(entry[key])
    }
    return fallback
}

func list_opt(entry, key) {
    if truthy(has_key(entry, key)) {
        v := entry[key]
        if type(v) == "array" {
            return v
        }
    }
    return []
}

# Find a validated service by configured port. Returns the ServiceConfig or null.
export func service_for_port(services, port) {
    mut sfp_i := 0
    sfp_n := len(services)
    while sfp_i < sfp_n {
        if port != null && services[sfp_i]["port"] == port {
            return services[sfp_i]
        }
        sfp_i = sfp_i + 1
    }
    return null
}

# Find a validated service by id. Returns the ServiceConfig or null.
export func service_by_id(services, id) {
    mut sbi_i := 0
    sbi_n := len(services)
    while sbi_i < sbi_n {
        if services[sbi_i]["id"] == id {
            return services[sbi_i]
        }
        sbi_i = sbi_i + 1
    }
    return null
}


from src.health import local_health_url
from src.util import is_http_url

func default_health(entry, port) {
    if get(entry, "health") != null {
        return "http"
    }
    if port != null {
        return "tcp"
    }
    return "process"
}

func validate_fields(entry, port) {
    for key in ["name", "group", "cwd", "start", "stop", "health", "open", "description", "runtime", "executable", "health_type"] {
        val := get(entry, key)
        if val != null && (type(val) != "string" || len(val) > 8192) {
            return "'${key}' must be a string of at most 8192 characters"
        }
    }
    for key in ["enabled", "favorite", "sensitive"] {
        val := get(entry, key)
        if val != null && type(val) != "bool" {
            return "'${key}' must be true or false"
        }
    }
    for key in ["startup_timeout", "shutdown_timeout"] {
        val := get(entry, key)
        if val != null && (type(val) != "int" || val < 1 || val > 10) {
            return "'${key}' must be 1–10 seconds"
        }
    }
    open_url := get(entry, "open")
    if open_url != null && is_http_url(open_url) == false {
        return "Open URL must use HTTP or HTTPS"
    }
    health := get(entry, "health")
    if health != null && local_health_url(health) == false {
        return "Health URL must use HTTP(S) on localhost, 127.0.0.1, or [::1]"
    }
    kind := opt(entry, "health_type", default_health(entry, port))
    if includes(["http", "tcp", "process", "none"], kind) == false {
        return "Health check must be HTTP, TCP, Process, or None"
    }
    if (kind == "http" && health == null) || (kind == "tcp" && port == null) {
        return "HTTP needs a health URL and TCP needs a port"
    }
    timeout := get(entry, "probe_timeout_ms")
    if timeout != null && (type(timeout) != "int" || timeout < 100 || timeout > 800) {
        return "Probe timeout must be 100–800 milliseconds"
    }
    expected := get(entry, "expected_status")
    if expected != null && (type(expected) != "int" || expected < 100 || expected > 599 || kind != "http") {
        return "Expected HTTP status must be 100–599 and requires an HTTP check"
    }
    executable := get(entry, "executable")
    if executable != null && (executable == "" || starts_with(executable, "-") || (regex_match(executable, "[[:space:]]") && contains(executable, "/") == 0)) {
        return "Required executable must be a command name or executable path"
    }
    refs := get(entry, "env")
    if refs != null {
        if type(refs) != "array" || len(refs) > 32 {
            return "Environment references must be a list of up to 32 names"
        }
        for name in refs {
            if type(name) != "string" || regex_match(name, "^[A-Za-z_][A-Za-z0-9_]{0,127}$") == false {
                return "Environment references accept variable names only"
            }
        }
    }
    if port == null && get(entry, "start") == null {
        return "A service needs a port or a startup command"
    }
    return null
}
