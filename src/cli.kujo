# Yard :: cli
#
# Command dispatch. The default command (no args) starts the dashboard server;
# the rest are convenience wrappers around the same safe primitives the web API
# uses, so the CLI can never do anything the dashboard could not. All process
# control still flows through src/process.kujo, which only ever runs configured
# commands and graceful-by-default signals.
#
# Exit codes: 0 ok, 1 operational failure, 2 usage error.

from src.serve import serve
from src.config import resolve_path, load, service_by_id
from src.api import load_cfg, service_action, stop_port_action
from src.status import build_services, summarize
from src.util import truthy, display, pad_right, shell_quote, includes, is_http_url

VERSION := "0.1.0"
DEFAULT_PORT := 9753

# Yard's command switches are all valueless. Reject unknown switches and
# extra arguments before any command can act on a service.
func parse_args(tokens, bool_flags, max_positionals) {
    mut positionals := []
    mut flags := {}
    for token in tokens {
        if starts_with(token, "--") {
            name := substring(token, 2, len(token))
            if includes(bool_flags, name) == false {
                return {"error": "unknown option '${token}'"}
            }
            flags[name] := true
        } else {
            positionals = push(positionals, token)
        }
    }
    if len(positionals) > max_positionals {
        return {"error": "too many arguments"}
    }
    return {"positionals": positionals, "flags": flags, "error": null}
}

func has_flag(parsed, name) {
    return has_key(parsed["flags"], name) == 1
}

func positional(parsed, idx) {
    p := parsed["positionals"]
    if len(p) > idx {
        return p[idx]
    }
    return null
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

func cmd_serve(tokens) {
    parsed := parse_args(tokens, [], 1)
    if parsed["error"] != null {
        print("error: ${parsed["error"]}")
        return 2
    }
    port := dashboard_port(positional(parsed, 0))
    if type(port) != "int" || port < 1 || port > 65535 {
        print("error: server port must be 1–65535")
        return 2
    }
    try {
        return serve(port)
    } except e {
        print("error: could not serve Yard: ${e}")
        return 1
    }
}

func dashboard_port(explicit) {
    if type(explicit) != "null" {
        return parse_int(explicit)
    }
    configured := env_or("YARD_PORT", "")
    if configured == "" {
        return DEFAULT_PORT
    }
    return parse_int(configured)
}

func cmd_scan(tokens) {
    parsed := parse_args(tokens, ["json", "no-health"], 0)
    if parsed["error"] != null {
        print("error: ${parsed["error"]}")
        return 2
    }
    do_health := has_flag(parsed, "no-health") == false
    config := load_cfg()
    built := build_services(config, do_health, "1", null)
    services := built["services"]
    if has_flag(parsed, "json") {
        payload := {"summary": summarize(services), "services": services}
        if built["ok"] == false {
            payload["scan_error"] := built["scan_error"]
        }
        print(to_json_pretty(payload))
        if built["ok"] == false {
            return 1
        }
        return 0
    }
    if built["scan_error"] != null {
        print("scanner: ${built["scan_error"]}")
    }
    for error in config["errors"] {
        print("config error: ${error}")
    }
    for warning in config["warnings"] {
        print("config warning: ${warning}")
    }
    if len(services) == 0 {
        if built["ok"] == false {
            return 1
        }
        print("No localhost services detected.")
        print("Add managed services to your Yard config or start a dev server.")
        return 0
    }
    print_table(services)
    s := summarize(services)
    print("")
    print("running ${s["running_ports"]}  managed ${s["managed_running"]}/${s["managed_total"]}  unknown ${s["unknown_ports"]}  unhealthy ${s["unhealthy"]}  sensitive ${s["sensitive"]}  untracked ${s["untracked"]}")
    if built["ok"] == false {
        return 1
    }
    return 0
}

func print_table(services) {
    print(pad_right("PORT", 7) + pad_right("STATUS", 9) + pad_right("HEALTH", 11) + pad_right("PID", 8) + pad_right("KIND", 10) + pad_right("TRACKING", 11) + pad_right("NAME", 24) + "URL")
    mut i := 0
    n := len(services)
    while i < n {
        s := services[i]
        i = i + 1
        tracking := "unmanaged"
        if s["managed"] {
            tracking = "untracked"
            if s["state"] == "stopped" {
                tracking = "stopped"
            }
            if s["owned_by_yard"] {
                tracking = "yard"
            }
        }
        flag := ""
        if s["sensitive"] {
            flag = "*"
        }
        name := "${display(s["name"])}${flag}"
        print(pad_right("${s["port"]}", 7) + pad_right("${s["state"]}", 9) + pad_right("${s["health_status"]}", 11) + pad_right(display(s["pid"]), 8) + pad_right("${s["kind"]}", 10) + pad_right(tracking, 11) + pad_right(name, 24) + display(s["url"]))
    }
}

func resolve_svc(id) {
    config := load_cfg()
    svc := service_by_id(config["services"], id)
    if type(svc) != "dict" {
        print("error: no such managed service: '${id}'")
        return null
    }
    return svc
}

func cmd_service(tokens, action, flags, success_msg) {
    parsed := parse_args(tokens, flags, 1)
    if parsed["error"] != null {
        print("error: ${parsed["error"]}")
        return 2
    }
    id := positional(parsed, 0)
    if type(id) == "null" {
        usage := "usage: yard ${action} <id>"
        for flag in flags {
            usage = usage + " [--${flag}]"
        }
        print(usage)
        return 2
    }
    res := service_action(id, action, has_flag(parsed, "force"), has_flag(parsed, "yes"))
    if truthy(get(res, "needs_confirm")) {
        print("refusing to ${action} '${id}' without --yes: ${res["error"]}")
        return 1
    }
    message := "${success_msg} ${id}"
    if action != "stop" {
        message = message + " (pid ${display(get(res, "pid"))})"
    }
    return report(res, message)
}

func cmd_stop_port(tokens) {
    parsed := parse_args(tokens, ["force", "yes"], 1)
    if parsed["error"] != null {
        print("error: ${parsed["error"]}")
        return 2
    }
    pf := positional(parsed, 0)
    if type(pf) == "null" {
        print("usage: yard stop-port <port> [--force] [--yes]")
        return 2
    }
    port := parse_int(pf)
    if type(port) != "int" || port < 1 || port > 65535 {
        print("error: invalid port '${pf}'")
        return 2
    }
    res := stop_port_action(port, has_flag(parsed, "force"), has_flag(parsed, "yes"))
    if truthy(get(res, "needs_confirm")) {
        print("refusing to stop port ${port} without --yes: ${res["error"]}")
        return 1
    }
    if type(get(res, "stopped")) == "array" {
        for pid in res["stopped"] {
            print("stopped pid ${pid} on port ${port}")
        }
    }
    if res["ok"] == false {
        return report(res, "")
    }
    if len(res["stopped"]) == 0 {
        print("nothing listening on port ${port}")
    }
    return 0
}

func cmd_open(tokens) {
    parsed := parse_args(tokens, [], 1)
    if parsed["error"] != null {
        print("error: ${parsed["error"]}")
        return 2
    }
    id := positional(parsed, 0)
    url := null
    if id == null {
        port := dashboard_port(null)
        if type(port) != "int" || port < 1 || port > 65535 {
            print("error: server port must be 1–65535")
            return 2
        }
        url = "http://127.0.0.1:${port}"
    } else {
        svc := resolve_svc(id)
        if type(svc) == "null" {
            return 1
        }
        if type(svc["open"]) != "null" {
            url = svc["open"]
        } else {
            url = "http://127.0.0.1:${svc["port"]}"
        }
    }
    if is_http_url(url) == false {
        print("error: open URL must use HTTP or HTTPS")
        return 1
    }
    quoted := shell_quote(url)
    r := execute_status("open " + quoted + " || xdg-open " + quoted)
    if r.exitcode != 0 {
        print(url)
    } else {
        print("opening ${url}")
    }
    return 0
}

func cmd_config(tokens) {
    parsed := parse_args(tokens, [], 1)
    if parsed["error"] != null {
        print("error: ${parsed["error"]}")
        return 2
    }
    sub := positional(parsed, 0)
    path := resolve_path(null)
    if sub == "path" || type(sub) == "null" {
        print(path)
        return 0
    }
    if sub == "show" {
        cfg := load(path)
        print(to_json_pretty(cfg))
        return 0
    }
    print("usage: yard config [path|show]")
    return 2
}

func report(res, ok_msg) {
    if truthy(res["ok"]) {
        print(ok_msg)
        if has_key(res, "note") == 1 && type(res["note"]) != "null" {
            print("  note: ${res["note"]}")
        }
        return 0
    }
    print("error: ${display(res["error"])}")
    return 1
}

func print_help() {
    print("Yard ${VERSION} - localhost command center")
    print("")
    print("Usage: yard [command] [arguments]")
    print("")
    print("Commands:")
    print("  (none)              Start the dashboard server (default)")
    print("  serve [port]        Start the dashboard (default port ${DEFAULT_PORT})")
    print("  scan [--json] [--no-health]   List detected localhost services")
    print("  open [id]           Open the dashboard, or a managed service's URL")
    print("  start <id>          Start a managed service")
    print("  stop <id> [--force] [--yes]   Stop a managed service")
    print("  restart <id> [--yes]          Restart a managed service")
    print("  stop-port <port> [--force] [--yes]   Stop whatever listens on a port")
    print("  config [path|show]  Show config path (default) or dump parsed config")
    print("  version             Show version")
    print("  help                Show this help")
    print("")
    print("Environment: YARD_CONFIG (config path), YARD_DIR (state/logs), YARD_PORT")
}

# Entry point. `argv` is the user argument list from args().
export func main(argv) {
    if len(argv) == 0 {
        return cmd_serve([])
    }
    cmd := argv[0]
    rest := slice(argv, 1, len(argv))

    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        print_help()
        return 0
    }
    if cmd == "version" || cmd == "--version" || cmd == "-V" {
        print("yard ${VERSION}")
        return 0
    }
    if cmd == "serve" || cmd == "start-server" || cmd == "dashboard" {
        return cmd_serve(rest)
    }
    if cmd == "scan" || cmd == "ls" || cmd == "list" {
        return cmd_scan(rest)
    }
    if cmd == "open" {
        return cmd_open(rest)
    }
    if cmd == "start" {
        return cmd_service(rest, "start", [], "Started")
    }
    if cmd == "stop" {
        return cmd_service(rest, "stop", ["force", "yes"], "Stopped")
    }
    if cmd == "restart" {
        return cmd_service(rest, "restart", ["yes"], "Restarted")
    }
    if cmd == "stop-port" {
        return cmd_stop_port(rest)
    }
    if cmd == "config" {
        return cmd_config(rest)
    }

    print("error: unknown command '${cmd}'")
    print("Run 'yard help' for usage.")
    return 2
}
