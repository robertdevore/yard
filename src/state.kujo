# Yard :: state
#
# File-backed bookkeeping for services Yard has started. We remember the PID we
# spawned, when we started it, how many times we've restarted it, and where its
# logs live. This is the only mutable state Yard keeps, and it lives on disk
# (default ./.yard) so it survives the dashboard process restarting. Logs for
# managed services are captured to ./.yard/logs/<id>.log.

from src.util import truthy, iso_now, shell_quote

# Root state directory: $YARD_DIR or ./.yard in the working directory.
export func state_dir() {
    return env_or("YARD_DIR", ".yard")
}

export func logs_dir() {
    return join_path(state_dir(), "logs")
}

func state_path() {
    return join_path(state_dir(), "managed.json")
}

# Per-service log file (one rolling file per managed service id).
export func log_path(id) {
    return join_path(logs_dir(), "${id}.log")
}

# Create the state + logs directories if needed. Safe to call repeatedly.
export func ensure_dirs() {
    sd := state_dir()
    if path_is_dir(sd) == false {
        create_dir(sd)
    }
    ld := logs_dir()
    if path_is_dir(ld) == false {
        create_dir(ld)
    }
}

# Display remains available when a state file is unreadable. Control actions
# use the strict reader so they never replace unreadable state with an empty map.
export func load_state() {
    try {
        return load_control_state()
    } except e {
        return {}
    }
}

export func load_control_state() {
    p := state_path()
    if file_exists(p) == false {
        return {}
    }
    parsed := parse_json(read_file(p))
    if type(parsed) != "dict" {
        throw("managed state must be a JSON object: ${p}")
    }
    return parsed
}

export func save_state(state) {
    return write_file_atomic(state_path(), to_json_pretty(state), true)
}

export func get_entry(state, id) {
    if truthy(has_key(state, id)) {
        return state[id]
    }
    return null
}

# A fresh entry for a service Yard has just started.
export func new_entry(pid, process_started, log_file, start_cmd, restart_count) {
    return {
        "pid": pid,
        "process_started": process_started,
        "started_at": iso_now(),
        "restart_count": restart_count,
        "log_file": log_file,
        "start_cmd": start_cmd,
        "managed_by_yard": true
    }
}

# Bound the data read and returned even when the active log has grown large.
# Reading a suffix may split its first line, which is discarded when clipped.
export func read_logs(id, max_lines) {
    p := log_path(id)
    if file_exists(p) == false || max_lines <= 0 {
        return {"lines": [], "truncated": false}
    }
    if path_is_file(p) == false {
        throw("service log is not a regular file")
    }
    max_bytes := 262144
    r := execute_status("tail -c ${max_bytes} < " + shell_quote(p), {"max_output_bytes": max_bytes, "timeout_ms": 2000})
    if r.exitcode != 0 {
        throw("could not read service log: ${trim(r.stderr)}")
    }
    clipped := r.stdout_truncated || file_size(p) > max_bytes
    lines := split(r.stdout, "\n")
    end := len(lines)
    if lines[end - 1] == "" {
        end = end - 1
    }
    start := 0
    if clipped {
        start = 1
    }
    if end - max_lines > start {
        start = end - max_lines
        clipped = true
    }
    mut out := []
    while start < end {
        if lines[start] != "" {
            out = push(out, lines[start])
        }
        start = start + 1
    }
    return {"lines": out, "truncated": clipped}
}
