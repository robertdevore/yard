# Compose registered services, listeners and verified supervisor receipts.
from src.ports import scan
from src.knownports import known_label, is_sensitive, infer_kind, sensitive_listener
from src.state import load_display_state, get_entry
from src.supervisor import supervisor
from src.health import probe_target, probe_result, batch_health, passive_health, skipped

export func build_services(config, do_health, server_port) {
    scan_result := scan()
    loaded := load_display_state()
    state := loaded["state"]
    mut specs := {}
    mut configured_ports := {}
    for svc in config["services"] {
        if svc["port"] != null {
            configured_ports["${svc["port"]}"] := svc
        }
        spec := get(get_entry(state, svc["id"]), "supervisor")
        if type(spec) == "dict" {
            specs[svc["id"]] := spec
        }
    }
    snapshot := supervisor("snapshot", {"entries": specs}, 2000)
    processes := get(get(snapshot, "receipt"), "processes", {})
    owned := get(get(snapshot, "receipt"), "owned", {})
    mut sensitive_groups := {}
    for listener in scan_result["listeners"] {
        process := get(processes, "${listener["pid"]}")
        group := get(process, "group")
        svc := get(configured_ports, "${listener["port"]}")
        if group != null && sensitive_listener(listener, svc, get(process, "executable")) {
            sensitive_groups["${group}"] := true
        }
    }
    mut by_port := {}
    for listener in scan_result["processes"] {
        by_port["${listener["port"]}"] := listener
    }
    mut statuses := []
    mut targets := {}
    mut services := {}
    for svc in config["services"] {
        id := svc["id"]
        services[id] := svc
        listener := get(by_port, "${svc["port"]}")
        receipt := get(owned, id)
        # Prefer any listener in the verified group when the displayed port
        # has more than one address or owner.
        if receipt != null && svc["port"] != null {
            listener = null
            for candidate in scan_result["listeners"] {
                cp := get(processes, "${candidate["pid"]}")
                if candidate["port"] == svc["port"] && get(cp, "group") == receipt["pid"] {
                    listener = candidate
                    break
                }
            }
        }
        status := registered(svc, listener, receipt, get_entry(state, id), processes, sensitive_groups, scan_result["ok"] && snapshot["ok"] && loaded["error"] == null)
        if do_health && status["state"] == "running" && status["sensitive"] == false {
            target := probe_target(svc, server_port)
            if target != null {
                targets[id] := target
            }
        }
        statuses = push(statuses, status)
    }
    answers := batch_health(targets)
    mut output := []
    for status in statuses {
        id := status["id"]
        if has_key(targets, id) == 1 {
            health := probe_result(get(answers, id), services[id])
            status["health_status"] := health["status"]
            status["http_status"] := health["http_status"]
            status["response_ms"] := health["response_ms"]
        }
        output = push(output, status)
    }
    for listener in scan_result["processes"] {
        if get(configured_ports, "${listener["port"]}") == null {
            output = push(output, unidentified(listener, processes, sensitive_groups))
        }
    }

    return {"ok": (scan_result["ok"] && loaded["error"] == null), "scan_error": scan_result["error"], "state_error": loaded["error"], "services": output}
}

func registered(svc, listener, owned, entry, processes, sensitive_groups, trustworthy) {
    port := svc["port"]
    pid := get(listener, "pid", get(owned, "child"))
    group := get(owned, "pid")
    process := get(processes, "${pid}")
    sensitive := svc["sensitive"] || is_sensitive(port, svc["start"]) || has_key(sensitive_groups, "${group}") == 1
    if listener != null && sensitive_listener(listener, svc, get(process, "executable")) {
        sensitive = true
    }
    has_start := svc["enabled"] && type(svc["start"]) == "string" && trim(svc["start"]) != ""
    state := "stopped"
    diagnostic := get(entry, "error")
    if trustworthy == false {
        state = "unknown"
        diagnostic = "Listener or process identity inspection was incomplete."
    }
    if owned != null {
        state = "running"
        if get(owned, "stopping") && get(entry, "outcome") != "stop_failed" {
            state = "stopping"
        } else {
            if port != null && listener == null {
                state = "starting"
                if get(entry, "outcome") == "failed" {
                    state = "failed"
                }
            }
        }
    } else {
        if listener != null {
            state = "running"
            diagnostic = "This listener is running outside Yard or its ownership could not be verified."
        } else {
            if get(entry, "outcome") == "running" || get(entry, "outcome") == "starting" {
                state = "failed"
                diagnostic = "The supervised process exited unexpectedly. Check recent logs."
            }
            if get(entry, "outcome") == "failed" {
                state = "failed"
            }
            if get(entry, "outcome") == "stop_failed" && state == "stopped" {
                diagnostic = null
            }
        }
    }
    url := null
    if port != null {
        url = "http://127.0.0.1:${port}"
    }
    open := svc["open"]
    if open == null && svc["health_type"] == "http" {
        open = url
    }
    health := skipped("unknown")
    if state == "running" {
        if owned != null || svc["health_type"] != "process" {
            health = passive_health(svc)
        }
        if sensitive {
            health = skipped("not_http")
        }
    }
    return {
        "id": svc["id"], "name": svc["name"], "group": svc["group"], "favorite": svc["favorite"],
        "port": port, "url": url, "open_url": open, "description": svc["description"],
        "managed": true, "enabled": svc["enabled"], "sensitive": sensitive,
        "untracked": (listener != null && owned == null), "owned_by_yard": (owned != null),
        "pid": pid, "process_group": group, "parent_pid": get(process, "parent"),
        "command": get(process, "executable"), "process_name": get(listener, "process_name"),
        "user": get(listener, "user"), "address": get(listener, "address"),
        "ip_version": get(listener, "ip_version"), "known_label": known_label(port),
        "kind": infer_kind(port, get(process, "executable")), "state": state, "diagnostic": diagnostic,
        "started_at": get(entry, "started_at"), "restart_count": get(entry, "restart_count", 0),
        "health_status": health["status"], "http_status": null, "response_ms": null,
        "actions": {
            "open": (state == "running" && open != null), "copy": (open != null),
            "start": (has_start && owned == null && listener == null && trustworthy),
            "stop": (owned != null), "force_stop": (owned != null && sensitive == false),
            "restart": (has_start && owned != null && state != "stopping"),
            "logs": true, "inspect": true, "claim": false
        }
    }
}

func unidentified(listener, processes, sensitive_groups) {
    pid := listener["pid"]
    port := listener["port"]
    process := get(processes, "${pid}")
    group := get(process, "group")
    executable := get(process, "executable")
    sensitive := has_key(sensitive_groups, "${group}") == 1 || sensitive_listener(listener, null, executable)
    return {
        "id": null, "name": listener["process_name"], "group": "Unknown", "port": port,
        "managed": false, "sensitive": sensitive, "untracked": false, "owned_by_yard": false,
        "pid": pid, "parent_pid": get(process, "parent"), "command": executable,
        "process_name": listener["process_name"], "user": listener["user"], "address": listener["address"],
        "ip_version": listener["ip_version"], "known_label": known_label(port), "kind": infer_kind(port, executable),
        "state": "running", "health_status": "not_checked", "http_status": null, "response_ms": null,
        "actions": {"inspect": true, "claim": true}
    }
}

# Aggregate the summary cards from a ServiceStatus list.
export func summarize(statuses) {
    mut running := 0
    mut managed_running := 0
    mut unknown_running := 0
    mut unhealthy := 0
    mut sensitive := 0
    mut untracked := 0
    mut managed_total := 0
    mut stopped := 0

    mut i := 0
    n := len(statuses)
    while i < n {
        s := statuses[i]
        i = i + 1
        if s["managed"] {
            managed_total = managed_total + 1
        }
        if s["state"] == "running" {
            running = running + 1
            if s["managed"] {
                managed_running = managed_running + 1
            } else {
                unknown_running = unknown_running + 1
            }
            if s["sensitive"] {
                sensitive = sensitive + 1
            }
            hs := s["health_status"]
            if hs == "unhealthy" || hs == "timeout" {
                unhealthy = unhealthy + 1
            }
            if s["untracked"] {
                untracked = untracked + 1
            }
        } else {
            stopped = stopped + 1
        }
    }

    return {
        "running_ports": running,
        "managed_running": managed_running,
        "managed_total": managed_total,
        "unknown_ports": unknown_running,
        "unhealthy": unhealthy,
        "sensitive": sensitive,
        "untracked": untracked,
        "stopped_managed": stopped
    }
}
