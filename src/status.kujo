# Yard :: status
#
# Composition layer. It fuses the four inputs — detected listeners, the managed
# config, Yard's start-state, and health probes — into the ServiceStatus list
# the API and UI consume, plus a summary. This is where "managed vs unknown",
# "sensitive", "which actions are safe", and "is this managed listener tracked
# by Yard" are all decided. It performs read-only inspection only.

from src.util import truthy
from src.ports import scan, full_command, process_identity
from src.knownports import known_label, is_sensitive, infer_kind, sensitive_listener
from src.health import check, skipped
from src.state import load_state, get_entry

# Build the full ServiceStatus list. `do_health` gates the (slower) HTTP probes
# so callers can ask for a fast structural view. Returns:
#   { "ok": bool, "scan_error": str|null, "services": [ServiceStatus...] }
export func build_services(config, do_health, health_timeout_secs, server_port) {
    services_cfg := config["services"]
    scan_result := scan()
    detected := scan_result["processes"]
    state := load_state()

    mut statuses := []
    mut services_by_port := {}
    mut commands_by_pid := {}
    mut seen_ports := {}
    mut sensitive_pids := {}
    for service in services_cfg {
        services_by_port["${service["port"]}"] := service
    }
    for listener in detected {
        pid_key := "${listener["pid"]}"
        if truthy(has_key(commands_by_pid, pid_key)) == false {
            commands_by_pid[pid_key] := full_command(listener["pid"])
        }
    }
    for listener in scan_result["listeners"] {
        pid_key := "${listener["pid"]}"
        if has_key(commands_by_pid, pid_key) == 0 || has_key(sensitive_pids, pid_key) == 1 {
            continue
        }
        service := get(services_by_port, "${listener["port"]}")
        if sensitive_listener(listener, service, commands_by_pid[pid_key]) {
            sensitive_pids[pid_key] := true
        }
    }
    for listener in detected {
        port_key := "${listener["port"]}"
        pid_key := "${listener["pid"]}"
        seen_ports[port_key] := true
        statuses = push(statuses, status_for_detected(listener, get(services_by_port, port_key), state, commands_by_pid[pid_key], has_key(sensitive_pids, pid_key) == 1, do_health, health_timeout_secs, server_port))
    }

    for service in services_cfg {
        if truthy(has_key(seen_ports, "${service["port"]}")) == false {
            statuses = push(statuses, status_for_stopped(service))
        }
    }

    return {"ok": scan_result["ok"], "scan_error": scan_result["error"], "services": statuses}
}

# Build a ServiceStatus for a port we actually saw listening.
func status_for_detected(p, svc, state, cmd, sensitive, do_health, health_timeout_secs, server_port) {
    port := p["port"]
    pid := p["pid"]
    process_name := p["process_name"]
    cmd_text := process_name
    if type(cmd) != "null" {
        cmd_text = cmd
    }

    managed := type(svc) == "dict"
    url := inferred_url(port, p["address"], p["ip_version"])
    open_url := url
    if managed && type(svc["open"]) != "null" {
        open_url = svc["open"]
    }

    # Ownership: did Yard start the process now on this port?
    entry := managed_entry(state, svc, managed)
    owned := false
    started_at := null
    restart_count := 0
    if type(entry) == "dict" {
        if get(entry, "pid") == pid && type(get(entry, "process_started")) == "string" {
            identity := process_identity(pid)
            owned = identity["started"] == entry["process_started"]
        }
        started_at = get(entry, "started_at")
        if type(get(entry, "restart_count")) == "int" {
            restart_count = entry["restart_count"]
        }
    }
    # A managed listener can be healthy and correct without having been started
    # by Yard. Call that state untracked; it is not evidence of a port conflict.
    untracked := managed && (owned == false)

    health := health_for(svc, managed, sensitive, url, do_health, health_timeout_secs, server_port)

    name := process_name
    group := "Unknown"
    has_start := false
    sid := null
    description := null
    if managed {
        name = svc["name"]
        group = svc["group"]
        has_start = type(svc["start"]) != "null" && "${svc["start"]}" != ""
        sid = svc["id"]
        description = svc["description"]
    }

    return {
        "id": sid,
        "name": name,
        "group": group,
        "port": port,
        "url": url,
        "open_url": open_url,
        "managed": managed,
        "sensitive": sensitive,
        "untracked": untracked,
        "owned_by_yard": owned,
        "pid": pid,
        "command": cmd_text,
        "process_name": process_name,
        "user": p["user"],
        "address": p["address"],
        "ip_version": p["ip_version"],
        "known_label": known_label(port),
        "kind": infer_kind(port, cmd_text),
        "description": description,
        "started_at": started_at,
        "restart_count": restart_count,
        "health_status": health["status"],
        "http_status": health["http_status"],
        "response_ms": health["response_ms"],
        "state": "running",
        "actions": actions_for(managed, has_start, true)
    }
}

# Build a ServiceStatus for a managed service that is configured but not running.
func status_for_stopped(svc) {
    port := svc["port"]
    sensitive := truthy(svc["sensitive"]) || is_sensitive(port, svc["start"])
    has_start := type(svc["start"]) != "null" && "${svc["start"]}" != ""
    url := inferred_url(port, "127.0.0.1", "IPv4")
    open_url := url
    if type(svc["open"]) != "null" {
        open_url = svc["open"]
    }
    return {
        "id": svc["id"],
        "name": svc["name"],
        "group": svc["group"],
        "port": port,
        "url": url,
        "open_url": open_url,
        "managed": true,
        "sensitive": sensitive,
        "untracked": false,
        "owned_by_yard": false,
        "pid": null,
        "command": null,
        "process_name": null,
        "user": null,
        "address": null,
        "ip_version": null,
        "known_label": known_label(port),
        "kind": infer_kind(port, svc["start"]),
        "description": svc["description"],
        "started_at": null,
        "restart_count": 0,
        "health_status": "unknown",
        "http_status": null,
        "response_ms": null,
        "state": "stopped",
        "actions": actions_for(true, has_start, false)
    }
}

func managed_entry(state, svc, managed) {
    if managed == false {
        return null
    }
    return get_entry(state, svc["id"])
}

# Choose a health probe strategy. Sensitive services are never probed over HTTP.
func health_for(svc, managed, sensitive, url, do_health, health_timeout_secs, server_port) {
    if do_health == false {
        return skipped("unknown")
    }
    if sensitive {
        return skipped("not_http")
    }
    target := url
    if managed && type(svc["health"]) != "null" && "${svc["health"]}" != "" {
        target = svc["health"]
    }
    return check(target, health_timeout_secs)
}

func points_to_yard(url, port) {
    if type(url) != "string" {
        return false
    }
    parts := split(to_lower(url), "/")
    if len(parts) < 3 || (parts[0] != "http:" && parts[0] != "https:") {
        return false
    }
    host := split(split(parts[2], "?")[0], "#")[0]
    return host == "127.0.0.1:${port}" || host == "localhost:${port}" || host == "[::1]:${port}" || host == "0.0.0.0:${port}"
}

# A wildcard listener is reachable on the loopback of its address family.
func inferred_url(port, address, ip_version) {
    host := "${address}"
    if host == "*" || host == "" {
        host = "127.0.0.1"
        if ip_version == "IPv6" {
            host = "[::1]"
        }
    }
    if host == "0.0.0.0" {
        host = "127.0.0.1"
    }
    if host == "::" || host == "[::]" {
        host = "[::1]"
    }
    if truthy(contains(host, ":")) && substring(host, 0, 1) != "[" {
        host = "[" + host + "]"
    }
    return "http://${host}:${port}"
}

# The UI offers log reads for managed services and restart only when a
# running managed service has a start command. The API validates actions
# again against current listener and process state.
func actions_for(managed, has_start, running) {
    can_restart := managed && has_start
    is_unknown := managed == false
    if running {
        return {
            "open": true,
            "copy": true,
            "start": false,
            "stop": true,
            "force_stop": true,
            "restart": can_restart,
            "logs": managed,
            "inspect": true,
            "claim": is_unknown
        }
    }
    return {
        "open": false,
        "copy": true,
        "start": can_restart,
        "stop": false,
        "force_stop": false,
        "restart": false,
        "logs": managed,
        "inspect": true,
        "claim": false
    }
}

# Aggregate the summary cards from a ServiceStatus list.
export func summarize(statuses) {
    mut running := 0
    mut managed_running := 0
    mut unknown_running := 0
    mut unhealthy := 0
    mut sensitive := 0
    mut untracked := 0
    mut managed_total := 0
    mut stopped := 0

    mut i := 0
    n := len(statuses)
    while i < n {
        s := statuses[i]
        i = i + 1
        if s["managed"] {
            managed_total = managed_total + 1
        }
        if s["state"] == "running" {
            running = running + 1
            if s["managed"] {
                managed_running = managed_running + 1
            } else {
                unknown_running = unknown_running + 1
            }
            if s["sensitive"] {
                sensitive = sensitive + 1
            }
            hs := s["health_status"]
            if hs == "unhealthy" || hs == "timeout" {
                unhealthy = unhealthy + 1
            }
            if s["untracked"] {
                untracked = untracked + 1
            }
        } else {
            stopped = stopped + 1
        }
    }

    return {
        "running_ports": running,
        "managed_running": managed_running,
        "managed_total": managed_total,
        "unknown_ports": unknown_running,
        "unhealthy": unhealthy,
        "sensitive": sensitive,
        "untracked": untracked,
        "stopped_managed": stopped
    }
}
