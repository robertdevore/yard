# Yard :: serve
#
# Wires the HTTP routes to the API logic and starts the server. Two safety
# properties are enforced here at the transport layer:
#   1. The server binds ONLY to 127.0.0.1 (loopback). It is never reachable
#      from other machines on the network.
#   2. Every destructive (POST) endpoint requires a per-session action token,
#      sent in the JSON body. The token is embedded in the dashboard page, so
#      same-origin scripts can act, but a cross-origin page cannot forge a
#      request (it can neither read the token nor guess it).
#
# The action token lives in a module-level global so the inline route handlers
# (which execute with shared globals) can read it.

from src.web import index_html, web_asset
from src.api import services_payload, ports_payload
from src.api import service_action, service_action_target, stop_process_action, logs_payload
from src.util import truthy
from src.state import ensure_dirs, state_dir
from src.config import resolve_path
from src.registry import registry_payload, registry_action
from src.discovery import discover_projects, inspect_listener

HOST := "127.0.0.1"
LOG_LINES := 300

# Action token for this server session. Set by serve() before listening.
mut YARD_TOKEN := ""
mut YARD_PORT := 0
mut STATUS_CACHE := null
mut STATUS_TIME := 0

# Start the dashboard on the loopback interface at `port`. Blocks until killed.
export func serve(port) {
    ensure_dirs()
    YARD_TOKEN = reveal(secure_random_token(32))
    YARD_PORT = port

    print("")
    print("  Yard - localhost command center")
    print("  ------------------------------------------------")
    print("  Dashboard:  http://${HOST}:${port}")
    print("  Binding:    ${HOST} only (loopback)")
    print("  Config:     ${config_hint()}")
    print("  State/logs: ${state_dir()}")
    print("  Action token issued for this session.")
    print("  Press Ctrl+C to stop.")
    print("")

    srv := build_server(port)
    srv.listen()
    return 0
}

func config_hint() {
    return resolve_path(null)
}

# Construct the routed server. Each handler is a thin closure delegating to a
# top-level helper so the request logic stays testable and readable.
func build_server(port) {
    srv := http_listen(HOST, port)
    srv := srv.route("GET", "/", func(req) { return guarded(req, h_index) })
    srv := srv.route("GET", "/yard.css", func(req) { return guarded(req, h_css) })
    srv := srv.route("GET", "/yard.js", func(req) { return guarded(req, h_js) })
    srv := srv.route("GET", "/api/identity", func(req) { return guarded(req, h_identity) })
    srv := srv.route("GET", "/api/registry", func(req) { return guarded(req, h_registry) })
    srv := srv.route("POST", "/api/registry", func(req) { return guarded(req, h_registry_action) })
    srv := srv.route("POST", "/api/discovery/projects", func(req) { return guarded(req, h_projects) })
    srv := srv.route("GET", "/api/discovery/processes/:pid", func(req) { return guarded(req, h_inspect_listener) })
    srv := srv.route("GET", "/api/summary", func(req) { return guarded(req, h_summary) })
    srv := srv.route("GET", "/api/services", func(req) { return guarded(req, h_services) })
    srv := srv.route("GET", "/api/ports", func(req) { return guarded(req, h_ports) })
    srv := srv.route("GET", "/api/services/:id/logs", func(req) { return guarded(req, h_logs) })
    srv := srv.route("POST", "/api/services/:id/start", func(req) { return guarded(req, h_start) })
    srv := srv.route("POST", "/api/services/:id/stop", func(req) { return guarded(req, h_stop) })
    srv := srv.route("POST", "/api/services/:id/restart", func(req) { return guarded(req, h_restart) })
    srv := srv.route("POST", "/api/processes/:pid/stop", func(req) { return guarded(req, h_proc_stop) })
    srv := srv.route("POST", "/api/processes/:pid/force-stop", func(req) { return guarded(req, h_proc_force) })
    return srv
}

# ---------------------------------------------------------------------------
# Handlers
# ---------------------------------------------------------------------------

# The socket is loopback-bound. Check the HTTP authority as well, since
# browsers can reach a loopback address through a non-local DNS name.
func guarded(req, handler) {
    headers := req["header_values"]
    hosts := get(headers, "host")
    if type(hosts) != "array" || len(hosts) != 1 {
        return deny_host()
    }
    host := to_lower(hosts[0])
    if host != "127.0.0.1:${YARD_PORT}" && host != "localhost:${YARD_PORT}" &&
        (YARD_PORT != 80 || (host != "127.0.0.1" && host != "localhost")) {
        return deny_host()
    }
    origins := get(headers, "origin")
    if type(origins) != "null" && (len(origins) != 1 || origins[0] != "http://${host}") {
        return deny_host()
    }
    if req["method"] == "POST" {
        if len(req["body"]) > 262144 {
            return json_response(413, {"ok": false, "error": "JSON request exceeds 256 KiB"})
        }
        content := get(headers, "content-type")
        if type(content) != "array" || len(content) != 1 || to_lower(trim(split(content[0], ";")[0])) != "application/json" {
            return json_response(415, {"ok": false, "error": "Use application/json"})
        }
        if type(parse_body(req)) != "dict" {
            return json_response(400, {"ok": false, "error": "Request body must be a JSON object"})
        }
    }
    resp := set_header(handler(req), "Cache-Control", "no-store")
    return set_header(resp, "X-Content-Type-Options", "nosniff")
}

func deny_host() {
    return json_response(403, {"ok": false, "error": "request requires the local Yard origin"})
}

func h_index(req) {
    html := index_html(YARD_TOKEN)
    resp := http_response(200, html)
    resp := set_header(resp, "Content-Type", "text/html; charset=utf-8")
    resp := set_header(resp, "X-Frame-Options", "DENY")
    resp := set_header(resp, "Content-Security-Policy", "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'")
    return resp
}

func h_summary(req) {
    snapshot := status_snapshot(req)
    return json_response(200, {
        "ok": snapshot["ok"], "generated_at": snapshot["generated_at"], "scan_error": snapshot["scan_error"],
        "state_error": snapshot["state_error"], "config": snapshot["config"], "summary": snapshot["summary"]
    })
}

func h_services(req) {
    return json_response(200, status_snapshot(req))
}

func status_snapshot(req) {
    if want_health(req) == false {
        return services_payload(false, YARD_PORT)
    }
    if STATUS_CACHE == null || current_timestamp() - STATUS_TIME >= 1000 {
        STATUS_CACHE = services_payload(true, YARD_PORT)
        STATUS_TIME = current_timestamp()
    }
    return STATUS_CACHE
}

func h_css(req) {
    return set_header(http_response(200, web_asset("yard.css")), "Content-Type", "text/css; charset=utf-8")
}

func h_js(req) {
    return set_header(http_response(200, web_asset("yard.js")), "Content-Type", "text/javascript; charset=utf-8")
}

func h_identity(req) {
    return json_response(200, {"app": "yard", "version": "2.0", "config": resolve_path(null), "state": state_dir()})
}

func h_registry(req) {
    return json_response(200, registry_payload())
}

func h_registry_action(req) {
    body := parse_body(req)
    if token_ok(body) == false {
        return deny()
    }
    result := registry_action(body)
    STATUS_CACHE = null
    if result["ok"] == false {
        return json_response(400, result)
    }
    return json_response(200, result)
}

func h_projects(req) {
    body := parse_body(req)
    if token_ok(body) == false {
        return deny()
    }
    return json_response(200, discover_projects(get(body, "root")))
}

func h_inspect_listener(req) {
    return json_response(200, inspect_listener(parse_int(req["params"]["pid"])))
}

func h_ports(req) {
    return json_response(200, ports_payload())
}

func h_logs(req) {
    id := req["params"]["id"]
    return json_response(200, logs_payload(id, LOG_LINES))
}

func h_start(req) {
    body := parse_body(req)
    if token_ok(body) == false {
        return deny()
    }
    STATUS_CACHE = null
    return json_response(200, service_action(req["params"]["id"], "start", false, false))
}

func h_stop(req) {
    body := parse_body(req)
    if token_ok(body) == false {
        return deny()
    }
    STATUS_CACHE = null
    return json_response(200, service_action_target(req["params"]["id"], "stop", bflag(body, "force"), bflag(body, "confirm"), get(body, "target")))
}

func h_restart(req) {
    body := parse_body(req)
    if token_ok(body) == false {
        return deny()
    }
    STATUS_CACHE = null
    return json_response(200, service_action_target(req["params"]["id"], "restart", false, bflag(body, "confirm"), get(body, "target")))
}

func h_proc_stop(req) {
    body := parse_body(req)
    if token_ok(body) == false {
        return deny()
    }
    pid := parse_int(req["params"]["pid"])
    return json_response(200, stop_process_action(pid, bflag(body, "force"), bflag(body, "confirm")))
}

func h_proc_force(req) {
    body := parse_body(req)
    if token_ok(body) == false {
        return deny()
    }
    pid := parse_int(req["params"]["pid"])
    return json_response(200, stop_process_action(pid, true, bflag(body, "confirm")))
}

# ---------------------------------------------------------------------------
# Request helpers
# ---------------------------------------------------------------------------

func want_health(req) {
    q := req["query"]
    if has_key(q, "health") == 1 {
        return q["health"] != "0"
    }
    return true
}

func parse_body(req) {
    b := "${req["body"]}"
    if trim(b) == "" {
        return null
    }
    mut p := null
    try {
        p = parse_json(b)
    } except e {
        return null
    }
    if type(p) != "dict" {
        return null
    }
    return p
}

func token_ok(body) {
    if type(body) == "dict" && has_key(body, "token") == 1 {
        return body["token"] == YARD_TOKEN
    }
    return false
}

func bflag(body, key) {
    if has_key(body, key) == 1 {
        return body[key] == true
    }
    return false
}

func deny() {
    return json_response(403, {"ok": false, "error": "invalid or missing action token"})
}
