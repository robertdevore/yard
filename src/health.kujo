# Yard :: health
#
# Lightweight, time-boxed HTTP health probing via curl. The goal is a fast,
# honest signal — "did this port answer an HTTP request, and how quickly" —
# without ever hanging the dashboard on a slow or non-HTTP service. Sensitive
# services (databases, model servers) are deliberately NOT probed over HTTP:
# speaking HTTP at a Postgres socket is pointless and just risks log noise, so
# we report them as not_http and move on.
#
# Status vocabulary: healthy | unhealthy | timeout | not_http | unknown.

from src.util import to_ms, last_segment
from src.supervisor import supervisor

# Map a curl exit code + "<http_code> <time_total>" output line into a health
# result. Exposed for unit testing without invoking curl.
export func interpret(exit_code, stdout) {
    parts := split(trim(stdout), " ")
    code := 0
    secs := 0.0
    if len(parts) >= 1 && parts[0] != "" {
        code = parse_int(parts[0])
        if type(code) != "int" {
            code = 0
        }
    }
    if len(parts) >= 2 {
        f := parse_float(parts[1])
        if type(f) == "float" {
            secs = f
        }
    }
    ms := to_ms(secs)

    if exit_code == 28 {
        return result("timeout", null, ms)
    }
    if exit_code == 0 {
        if code >= 200 && code <= 399 {
            return result("healthy", code, ms)
        }
        if code >= 400 && code <= 599 {
            return result("unhealthy", code, ms)
        }
        # Connected but no recognizable HTTP status (e.g. raw TCP service).
        return result("not_http", null, ms)
    }
    if exit_code == 7 {
        # Connection refused: listed by lsof but not accepting right now.
        return result("unknown", null, null)
    }
    # 52 empty reply, 56 recv error, 1 unsupported protocol, etc.
    return result("not_http", null, null)
}

func result(status, http_status, response_ms) {
    return {"status": status, "http_status": http_status, "response_ms": response_ms}
}

# A non-probing result for services we choose not to hit over HTTP.
export func skipped(reason) {
    return {"status": reason, "http_status": null, "response_ms": null}
}

export func service_health(svc, timeout_secs) {
    target := probe_target(svc, parse_int(env_or("YARD_ACTIVE_PORT", env_or("YARD_PORT", "9753"))))
    if target == null {
        return passive_health(svc)
    }
    target["timeout"] := timeout_secs
    answer := batch_health({"service": target})
    return probe_result(get(answer, "service"), svc)
}

export func passive_health(svc) {
    if svc["health_type"] == "process" {
        return skipped("process")
    }
    return skipped("not_checked")
}

export func probe_target(svc, server_port) {
    kind := svc["health_type"]
    if kind == "tcp" && svc["port"] != null && svc["port"] != server_port {
        return {"kind": "tcp", "port": svc["port"], "timeout": svc["probe_timeout_ms"] / 1000.0}
    }
    target := svc["health"]
    if kind == "http" && local_health_url(target) {
        authority := split(split(split(target, "/")[2], "?")[0], "#")[0]
        port := 80
        if starts_with(target, "https:") {
            port = 443
        }
        if regex_match(authority, ":[0-9]+$") {
            port = parse_int(last_segment(authority, ":"))
        }
        if port != server_port {
            return {"kind": "http", "url": target, "timeout": svc["probe_timeout_ms"] / 1000.0}
        }
    }
    return null
}

export func batch_health(targets) {
    if len(keys(targets)) == 0 {
        return {}
    }
    answer := supervisor("health", targets, 2300)
    if answer["ok"] {
        return answer["receipt"]
    }
    return {}
}

export func probe_result(raw, svc) {
    if type(raw) != "dict" {
        return skipped("pending")
    }
    if get(raw, "status") != null {
        return result(raw["status"], null, get(raw, "response_ms"))
    }
    answer := interpret(raw["exitcode"], raw["stdout"])
    if raw["exitcode"] == 7 {
        answer["status"] := "connection_failed"
    }
    expected := svc["expected_status"]
    if expected != null && answer["http_status"] != null {
        answer["status"] := "unhealthy"
        if answer["http_status"] == expected {
            answer["status"] := "healthy"
        }
    }
    return answer
}

export func local_health_url(target) {
    if type(target) != "string" {
        return false
    }
    return regex_match(target, "^https?://(localhost|127[.]0[.]0[.]1|\\[::1\\])(:[0-9]{1,5})?([/?#][^[:space:]]*)?$")
}
