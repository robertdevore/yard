#!/usr/bin/env bash
# Yard launcher.
#
# Thin convenience wrapper so you can type `yard <command>` instead of
# `kujo run /path/to/yard.kujo <command>`.
#
# It runs the Kujo interpreter on the project entrypoint, preserving your
# current working directory (so the default ./.yard state dir and
# ./yard.config.json land where you invoke it). Override the interpreter with
# the KUJO environment variable, e.g.
#   KUJO=/path/to/kujo/target/release/kujo yard scan
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
KUJO="${KUJO:-kujo}"

if ! command -v "$KUJO" >/dev/null 2>&1 && [ ! -x "$KUJO" ]; then
  echo "yard: cannot find the Kujo interpreter ('$KUJO')." >&2
  echo "Set KUJO to your kujo binary, e.g. KUJO=/path/to/kujo/target/release/kujo" >&2
  exit 127
fi

exec "$KUJO" run "$PROJECT_DIR/yard.kujo" "$@"
