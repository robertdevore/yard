# Yard entrypoint.
#
# Everything running locally is "in the yard." This thin wrapper hands the
# user's arguments to the CLI module and turns its return code into a process
# exit code. With no arguments it starts the local dashboard server.
#
# Run with:
#   kujo run yard.kujo -- <command> [arguments]
# or via the bin/yard wrapper:
#   ./bin/yard [command] [arguments]

from src.cli import main

code := main(args())
exit(code)
